# LocalInfra settings. Copy to .env and fill in.
# Generate secrets with:  openssl rand -hex 32
# (hex is safe inside URLs and Redis ACL files; avoid spaces and quotes)

TZ=America/Sao_Paulo

# ---- Postgres ----
PG_VERSION=17
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# Host port binding. Loopback only = reachable on the Pi itself or through an SSH
# tunnel from the Mac:  ssh -N -L 5432:127.0.0.1:5432 umbrel@umbrel.local
POSTGRES_PUBLISH=127.0.0.1:5432
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_WORK_MEM=8MB
# PG_MAX_CONNECTIONS=100
# PG_MEMORY_LIMIT=1G

# ---- Redis ----
REDIS_VERSION=7.4
REDIS_ADMIN_PASSWORD=
REDIS_PUBLISH=127.0.0.1:6379
REDIS_MAXMEMORY=256mb
# REDIS_MEMORY_LIMIT=384M

# ---- S3 (Garage) ----
GARAGE_VERSION=v2.4.1
# Generate with:  openssl rand -hex 32   (both)
S3_RPC_SECRET=
S3_ADMIN_TOKEN=
# Absolute path ON THE PI to a folder on the external drive; holds the metadata and the
# objects. Create the marker file once:  touch <S3_DATA_DIR>/.localinfra-s3-target
S3_DATA_DIR=/path/on/the/pi/to/external-drive/localinfra-s3
# S3 API host binding. Loopback only = reachable on the Pi itself or through an SSH tunnel.
S3_PUBLISH=127.0.0.1:3900
# S3_MEMORY_LIMIT=256M

# ---- Backups ----
# Absolute path ON THE PI to a folder on the external drive.
# Create the marker file once:  touch <BACKUP_DIR>/.localinfra-backup-target
BACKUP_DIR=/path/on/the/pi/to/external-drive/localinfra-backups
BACKUP_CRON="0 4 * * *"
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=6
BACKUP_ON_START=false
# Home Assistant's backups folder ON THE PI (read-only). Its newest backup is copied to
# <BACKUP_DIR>/homeassistant/ right after the Postgres dump.
# HA_BACKUP_SOURCE=/home/umbrel/umbrel/app-data/home-assistant/data/backups
# Newest Home Assistant backup older than this = the copy fails (HA stopped backing up)
# HA_BACKUP_MAX_AGE_HOURS=26

# ---- Cloudflare tunnel ----
CLOUDFLARED_VERSION=2026.9.3
# Zero Trust → Networks → Tunnels → the tunnel → Configure: the token in the "docker run" command
CLOUDFLARE_TUNNEL_TOKEN=
