# LocalInfra settings. Copy to .env and fill in.
# Generate secrets with:  openssl rand -hex 32
# (hex is safe inside URLs and Redis ACL files; avoid spaces and quotes)

TZ=America/Sao_Paulo

# ---- Postgres ----
PG_VERSION=17
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# Host port binding. Loopback only = reachable on the Pi itself or through an SSH
# tunnel from the Mac:  ssh -N -L 5432:127.0.0.1:5432 umbrel@umbrel.local
POSTGRES_PUBLISH=127.0.0.1:5432
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_WORK_MEM=8MB
# PG_MAX_CONNECTIONS=100
# PG_MEMORY_LIMIT=1G

# ---- Redis ----
REDIS_VERSION=7.4
REDIS_ADMIN_PASSWORD=
REDIS_PUBLISH=127.0.0.1:6379
REDIS_MAXMEMORY=256mb
# REDIS_MEMORY_LIMIT=384M

# ---- S3 (Garage) ----
GARAGE_VERSION=v2.4.1
# Generate with:  openssl rand -hex 32   (both)
S3_RPC_SECRET=
S3_ADMIN_TOKEN=
# Absolute path ON THE PI to a folder on the external drive; holds the metadata and the
# objects. Create the marker file once:  touch <S3_DATA_DIR>/.localinfra-s3-target
S3_DATA_DIR=/path/on/the/pi/to/external-drive/localinfra-s3
# S3 API host binding. Loopback only = reachable on the Pi itself or through an SSH tunnel.
S3_PUBLISH=127.0.0.1:3900
# S3_MEMORY_LIMIT=256M

# ---- Backups ----
# Absolute path ON THE PI to a folder on the external drive.
# Create the marker file once:  touch <BACKUP_DIR>/.localinfra-backup-target
BACKUP_DIR=/path/on/the/pi/to/external-drive/localinfra-backups
BACKUP_CRON="0 4 * * *"
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=6
BACKUP_ON_START=false
# Home Assistant's backups folder ON THE PI (read-only). Its newest backup is copied to
# <BACKUP_DIR>/homeassistant/ right after the Postgres dump.
# HA_BACKUP_SOURCE=/home/umbrel/umbrel/app-data/home-assistant/data/backups
# Newest Home Assistant backup older than this = the copy fails (HA stopped backing up)
# HA_BACKUP_MAX_AGE_HOURS=26

# ---- Cloudflare tunnel ----
# Container Health's status page says when a newer release is out (checked on Docker Hub)
CLOUDFLARED_VERSION=2026.10.4
# Zero Trust → Networks → Tunnels → the tunnel → Configure: the token in the "docker run" command
CLOUDFLARE_TUNNEL_TOKEN=

# ---- LLM (localinfra-llm: the gateway apps call + a local model) ----
# https://openrouter.ai/settings/keys. Only the gateway uses it; apps get their own key from
# scripts/new-project.sh <app> --llm. Without it, only the local model answers ("simple" tier).
OPENROUTER_API_KEY=
# Tiers apps ask for (model: "simple" | "medium" | "hard"). Comma-separated OpenRouter model ids,
# tried in order. simple may only list free models (":free" or openrouter/free); when they all
# fail, the local model answers.
# LLM_SIMPLE_MODELS=google/gemma-4-31b-it:free,openrouter/free
# LLM_MEDIUM_MODELS=anthropic/claude-haiku-5.5,openai/gpt-6-luna
# LLM_HARD_MODELS=anthropic/claude-sonnet-5.5,openai/gpt-6.1-sol
# Limits per app on paid calls (medium + hard). Change one app with:
#   docker exec localinfra-llm llm-admin limits <app> --monthly-usd 5 --daily-calls 500
LLM_DEFAULT_MONTHLY_USD=2
LLM_DEFAULT_DAILY_PAID_CALLS=200
# Output tokens per call are capped at this, whatever the app asks
# LLM_MAX_TOKENS=8192
# LLM_PUBLISH=127.0.0.1:4000
# Local model (Ollama, any tag from ollama.com/library). Downloaded on first start.
OLLAMA_VERSION=0.35.1
LLM_LOCAL_MODEL=gemma3:1b
# LLM_LOCAL_KEEP_ALIVE=30m
# LLM_LOCAL_CONTEXT=8192
# LLM_MEMORY_LIMIT=2G
