# ============================================
# <APP> - Environment Variables
# ============================================
# .env        → the Pi deploy. docker compose reads it ON THE MAC (Docker context "umbrel").
#               Filled by:  DOCKER_CONTEXT=umbrel ../LocalInfra/scripts/provision-app.sh <name> .
# .env.local  → local dev (npm run dev): same keys with localhost values; wins over .env.
# Both are git-ignored. Template: LocalInfra/templates/app/.env.example

# --- LocalInfra (written by provision-app.sh; keep only what the app uses) ---
DATABASE_URL=postgresql://myapp:<password>@localinfra-postgres:5432/myapp
POSTGRES_HOST=localinfra-postgres
POSTGRES_PORT=5432
REDIS_HOST=localinfra-redis
REDIS_PORT=6379
REDIS_USERNAME=myapp
REDIS_PASSWORD=<password>
REDIS_KEY_PREFIX=myapp:
S3_ENDPOINT=http://localinfra-s3:3900
S3_REGION=garage
S3_BUCKET=myapp
S3_ACCESS_KEY_ID=<key id>
S3_SECRET_ACCESS_KEY=<secret>
# Metrics (provision-app.sh --metrics). Empty in local dev: /api/metrics then drops what it gets
METRICS_URL=http://localinfra-metrics:4100
METRICS_API_KEY=

# --- App ---
# Host port on the Pi: the next free one from the port table in DEPLOYING-APPS.md
PORT=30XX
# Public URL (Cloudflare tunnel hostname). NEXT_PUBLIC_* is baked in at BUILD time: rebuild after
# changing it.
NEXT_PUBLIC_APP_URL=https://myapp.example.com
TZ=America/Sao_Paulo
# Auth, OAuth, API keys... (generate secrets with: openssl rand -base64 32)
