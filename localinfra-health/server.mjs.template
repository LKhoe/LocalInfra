const FAVICON = [
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">',
  "<defs>",
  '<linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1d1736"/><stop offset="1" stop-color="#07070d"/></linearGradient>',
  '<linearGradient id="neon" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#a78bfa"/><stop offset="1" stop-color="#22d3ee"/></linearGradient>',
  '<filter id="glow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="2.6"/></filter>',
  "</defs>",
  '<rect x="2" y="2" width="60" height="60" rx="17" fill="url(#bg)" stroke="#22d3ee" stroke-opacity=".5" stroke-width="2"/>',
  '<g fill="none" stroke="url(#neon)" stroke-linecap="round" stroke-linejoin="round">',
