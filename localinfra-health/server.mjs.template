const routes = {
  "/widgets/projects": async () => ({ type: "application/json", body: JSON.stringify(await projectsWidget()) }),
  "/widgets/summary": async () => ({ type: "application/json", body: JSON.stringify(await summaryWidget()) }),
  "/widgets/gauges": async () => ({ type: "application/json", body: JSON.stringify(await gaugesWidget()) }),
  "/healthz": async () => ({ type: "text/plain", body: "ok" }),
  "/favicon.svg": async () => ({ type: "image/svg+xml", body: FAVICON, cache: "public, max-age=86400" }),
  "/site-icon": async (url) => siteIconFor(url.searchParams.get("app")),
  "/live": async () => ({ type: "text/html; charset=utf-8", body: (await livePart()).html }),
  "/speedtest": async () => ({ type: "application/json", body: JSON.stringify({ running: speed.running, phase: speed.phase, html: speedBody() }) }),
  "/": async () => ({ type: "text/html; charset=utf-8", body: await statusPage() }),
};

// POST routes start something, so they refuse anything a browser could send from another site:
// the custom header forces a CORS preflight (never answered here) and Sec-Fetch-Site must be ours
const posts = {
  "/speedtest": async (url, req) => {
    const site = req.headers["sec-fetch-site"];
    if (req.headers["x-speedtest"] !== "1" || (site && site !== "same-origin")) return { status: 403, type: "application/json", body: '{"error":"Not allowed."}' };
    const { status, error } = startSpeedTest();
    return { status, type: "application/json", body: JSON.stringify(error ? { error } : { started: true }) };
  },
};

http
  .createServer(async (req, res) => {
    const url = new URL(req.url, "http://localhost");
    const route = req.method === "GET" ? routes[url.pathname] : req.method === "POST" ? posts[url.pathname] : undefined;
    if (!route) {
      res.writeHead(404, { "content-type": "text/plain" }).end("Not found");
      return;
    }
    try {
      const { type, body, cache, headers, status } = await route(url, req);
      res
        .writeHead(status || 200, { "content-type": type, "cache-control": cache || "no-store", "x-content-type-options": "nosniff", ...headers })
        .end(body);
    } catch (error) {
      res.writeHead(500, { "content-type": "text/plain" }).end(String(error?.message || error));
    }
  })
  .listen(PORT, () => console.log("Container Health listening on :" + PORT));
