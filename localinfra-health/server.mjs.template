const resourceStyle = (r) => "--c: var(--" + r.key + ")";

function memoryCell(reading) {
  if (!reading) return '<div class="mem"><span><em>–</em></span></div>';
  const whole = reading.limit || os.totalmem();
  const share = reading.used / whole;
  return (
    '<div class="mem" title="' + (reading.limit ? "Memory limit " + bytes(reading.limit) : "No memory limit: share of the Pi's memory") + '">' +
    "<span>" + bytes(reading.used) + (reading.limit ? "<em> / " + bytes(reading.limit) + "</em>" : "") + "</span>" +
    '<i class="bar' + (share > 0.85 ? " hot" : "") + '"><i style="width:' + pct(reading.used, whole) + '%"></i></i></div>'
  );
}

function tiles(snap, mem) {
  const t = totals(snap);
  let mine = 0;
  for (const c of snap.containers) mine += mem.get(c.id)?.used || 0;
  const total = os.totalmem();
  const hostUsed = total - os.freemem();
  const tile = (cls, k, value, of, sub, extra) =>
    '<div class="tile glass' + (cls ? " " + cls : "") + '"><span class="k">' + k + "</span><b>" + value +
    (of != null ? "<em>/" + of + "</em>" : "") + '</b><span class="s">' + sub + "</span>" + (extra || "") + "</div>";
  return (
    '<div class="tiles">' +
    tile("", "Containers", t.okContainers, t.containers, "healthy") +
    tile("", "Projects", t.okProjects, t.projects, "healthy") +
    tile(t.issues ? "bad" : "good", "Issues", t.issues, null, t.issues ? "need a look" : "all clear") +
    tile("", "Memory", escape(bytes(mine)), null, "Pi " + bytes(hostUsed) + " / " + bytes(total),
      '<i class="bar"><i class="host" style="width:' + pct(hostUsed, total) + '%"></i><i style="width:' + pct(mine, total) + '%"></i></i>') +
    "</div>"
  );
}

function resourceMap(snap, mem) {
  const byName = new Map(snap.containers.map((c) => [c.name, c]));
  const apps = snap.containers
    .filter((c) => c.uses.length && c.project !== LOCALINFRA_PROJECT)
    .sort((a, b) => (a.project || a.name).localeCompare(b.project || b.name) || a.name.localeCompare(b.name));
  if (!apps.length) {
    return '<div class="glass empty">No app uses LocalInfra yet. Join a <code>localinfra_*</code> network to show up here.</div>';
  }
  const H = Math.max(apps.length * 58, RESOURCES.length * 66);
  const yApp = (i) => ((i + 0.5) * H) / apps.length;
  const yRes = (j) => ((j + 0.5) * H) / RESOURCES.length;

  let edges = "";
  apps.forEach((c, i) => {
    for (const key of c.uses) {
      const j = RESOURCES.findIndex((r) => r.key === key);
      const a = yApp(i).toFixed(1);
      const b = yRes(j).toFixed(1);
      const d = "M0 " + a + " C50 " + a + " 50 " + b + " 100 " + b;
      const data = ' data-app="' + escape(c.name) + '" data-res="' + key + '" stroke="var(--' + key + ')"';
      edges += ["glow", "line", "flow"].map((cls) => '<path class="' + cls + '" d="' + d + '"' + data + "/>").join("");
    }
  });

  const left = apps
    .map((c) => {
      const sub = c.project && c.project !== c.name ? c.project : "";
      return (
        '<div class="pill" data-app="' + escape(c.name) + '" title="' + escape(c.name + " · " + c.status) + '"><span class="dot st-' + c.state + '"></span>' +
        appIcon(c) + '<span class="t"><b>' + escape(c.name) + "</b>" + (sub ? "<small>" + escape(sub) + "</small>" : "") + "</span></div>"
      );
    })
    .join("");

  const right = RESOURCES.map((r) => {
    const provider = byName.get(r.provider);
    const users = apps.filter((c) => c.uses.includes(r.key)).length;
    const reading = provider && mem.get(provider.id);
    const sub = users + (users === 1 ? " app" : " apps") + (reading ? " · " + bytes(reading.used) : "");
    const state = provider ? provider.state : "unknown";
    return (
      '<div class="pill res" data-res="' + r.key + '" style="' + resourceStyle(r) + '" title="' +
      escape((provider ? provider.name + " · " + provider.status : r.label + ": container not found") + " · network " + r.network) + '">' +
      '<span class="ico">' + icon(r.key) + '</span><span class="t"><b>' + r.label + "</b><small>" + sub + "</small></span>" +
      '<span class="dot st-' + state + '"></span></div>'
    );
  }).join("");

  return (
    '<div class="map glass" style="--h:' + H + 'px">' +
    '<div class="col l">' + left + "</div>" +
    '<svg class="edges" viewBox="0 0 100 ' + H + '" preserveAspectRatio="none" aria-hidden="true">' + edges + "</svg>" +
    '<div class="col r">' + right + "</div></div>"
  );
}

// "1.4.2" -> "v1.4.2"; tags like "17-alpine" or "v2.4.1" stay as they are
function versionChip(v) {
  if (!v || !v.version) return "";
  const text = /^[0-9]+\.[0-9]/.test(v.version) ? "v" + v.version : v.version;
  return '<span class="ver" title="Version (' + escape(v.source) + ')">' + escape(text.slice(0, 40)) + "</span>";
}

// A newer release of a pinned image (UPDATE_CHECKS), next to its version
function updateChip(u) {
  return u
    ? '<a class="ver new" href="' + escape(u.check.notes) + '" target="_blank" rel="noopener noreferrer" title="' +
        escape(u.check.name + " " + u.latest + " is out: release notes") + '">' + icon("up") + escape(u.latest) + "</a>"
    : "";
}

function containerRow(c, mem, versions, updates) {
  const chips = c.uses
    .map((key) => {
      const r = RESOURCES.find((x) => x.key === key);
      return '<span class="rc" style="' + resourceStyle(r) + '" title="' + r.label + " (" + r.network + ')">' + r.short + "</span>";
    })
    .join("");
  return (
    '<li class="row st-' + c.state + '"><span class="dot"></span>' +
    '<div class="who"><span class="nm"><b>' + escape(c.name) + "</b>" + versionChip(versions.get(c.id)) + updateChip(updates.get(c.name)) + appLink(c, "url") + "</span><small>" + escape(c.status) + "</small></div>" +
    '<div class="chips">' + chips + "</div>" + memoryCell(mem.get(c.id)) + "</li>"
  );
}

function projectCard(p, mem, versions, updates) {
  let used = 0;
  for (const c of p.containers) used += mem.get(c.id)?.used || 0;
  return (
    '<section class="proj glass"><div class="proj-h"><span class="dot st-' + p.state + '"></span><h3>' + escape(p.name) + "</h3>" +
    '<span class="n">' + p.ok + "/" + p.containers.length + " healthy</span>" +
    '<span class="m">' + (used ? bytes(used) : "") + "</span></div>" +
    '<ul class="rows">' + p.containers.map((c) => containerRow(c, mem, versions, updates)).join("") + "</ul></section>"
  );
}

// "how long ago" in words; the page script adds the local date and time (the server has no TZ)
function ago(ms) {
  const min = Math.round((Date.now() - ms) / 60000);
  if (min < 1) return "just now";
  if (min < 60) return min + " min ago";
  const h = Math.round(min / 60);
  if (h < 48) return h + " h ago";
  return Math.round(h / 24) + " days ago";
}

const when = (ms) => '<time data-ts="' + ms + '" data-ago="' + ago(ms) + '" datetime="' + new Date(ms).toISOString() + '">' + ago(ms) + "</time>";

const duration = (s) => (s < 90 ? Math.max(0, s) + " s" : Math.round(s / 60) + " min");

// "0 4 * * *" -> "daily at 04:00"; anything fancier is shown as it is
function schedule(cron) {
  const f = (cron || "").trim().split(/\s+/);
  const num = (x) => String(Number(x)) === x;
  if (f.length === 5 && num(f[0]) && num(f[1]) && f.slice(2).join(" ") === "* * *") {
    return "daily at " + f[1].padStart(2, "0") + ":" + f[0].padStart(2, "0");
  }
  return cron ? "cron " + cron : "";
}

// globals.sql -> "roles", my_recipes.dump -> "my_recipes"; the Home Assistant .tar keeps its name
const backupFileName = (name) => (name === "globals.sql" ? "roles (globals.sql)" : name.endsWith(".dump") ? name.slice(0, -5) : name);

function backupCard(j) {
  const run = j.lastRun;
  const good = j.lastGood;
  const info = run || good;
  const rows = [];
  if (j.error) rows.push(["Status", '<span class="bad">couldn\'t read it from ' + escape(BACKUP_CONTAINER) + "</span>"]);
  if (run) {
    rows.push(["Last run", when(run.finished * 1000) + " · " +
      (run.ok ? '<span class="good">succeeded</span> in ' + duration(run.finished - run.started) : '<span class="bad">failed: ' + escape(run.error || "see the logs") + "</span>")]);
  }
  if (j.successAt && !(run && run.ok && run.finished * 1000 === j.successAt)) rows.push(["Last success", when(j.successAt)]);
  if (!run && !j.successAt && !j.error) rows.push(["Status", "No backup yet: the first one runs " + (schedule(info && info.schedule) || "at BACKUP_CRON") + "."]);
  if (j.state === "unhealthy" && j.successAt && Date.now() - j.successAt >= BACKUP_STALE_MS) {
    rows.push(["", '<span class="bad">No good backup in the last ' + BACKUP_STALE_MS / 3600000 + " hours</span>"]);
  }

  const files = good && Array.isArray(good.files) ? good.files : [];
  const shown = files.slice(0, 14);
  const list = files.length
    ? '<ul class="files" title="In the newest set">' +
      shown.map((f) => "<li>" + escape(backupFileName(String(f.name))) + "<em>" + bytes(f.bytes) + "</em></li>").join("") +
      (files.length > shown.length ? "<li>+" + (files.length - shown.length) + " more</li>" : "") + "</ul>"
    : "";

  const kept = info
    ? (info.daily != null ? info.daily + " daily" : "daily") + " (" + info.keepDays + " days)" +
      (info.monthly != null ? " + " + info.monthly + " monthly" : " + monthly") + " (" + info.keepMonths + " months)"
    : "";
  const foot = good && good.set
    ? '<small class="foot">' + escape(j.key + "/" + good.set) + " · " + bytes(good.bytes) + (kept ? " · sets kept: " + kept : "") + "</small>"
    : "";

  return (
    '<section class="bk glass" style="--c: var(--' + j.c + ')"><div class="bk-h"><span class="dot st-' + j.state + '"></span>' +
    '<span class="gi">' + mark(j.key) + "</span><b>" + escape(j.label) + "</b>" +
    '<span class="n">' + escape(schedule(info && info.schedule)) + "</span></div>" +
    '<p class="what">' + escape(j.what) + "</p>" +
    '<dl class="kv">' + rows.map(([k, v]) => "<dt>" + k + "</dt><dd>" + v + "</dd>").join("") + "</dl>" + list + foot + "</section>"
  );
}

function backupSection(b) {
  if (!b.container) {
    return '<div class="glass empty">' + escape(BACKUP_CONTAINER) + " is not running here, so nothing is being backed up.</div>";
  }
  return (
    '<div class="bks">' + b.jobs.map(backupCard).join("") + "</div>" +
    '<p class="intg-note">Saved on the external drive (BACKUP_DIR). Not in it: Redis (cache and queues), the LLM gateway\'s volume ' +
    "(re-issue keys with new-project.sh --llm --rotate) and the S3 objects, which live on the RAID 1 drive itself.</p>"
  );
}

const num = (n) => (typeof n === "number" && Number.isFinite(n) ? n : null);
const count = (n) => (n >= 10000 ? (n / 1000).toFixed(0) + "k" : n >= 1000 ? (n / 1000).toFixed(1) + "k" : String(n));

// The service's histograms start at 100 ms (0.01 for CLS): below that, only "under" is known
function vitalValue(v, value) {
  if (value == null) return "–";
  if (v.key === "CLS") return value < 0.01 ? "< 0.01" : value.toFixed(2);
  if (value < 100) return "< 100 ms";
  return value >= 1000 ? (value / 1000).toFixed(value >= 10000 ? 0 : 1) + " s" : Math.round(value) + " ms";
}
const rating = (v, value) => (value == null ? "none" : value <= v.good ? "good" : value <= v.poor ? "warn" : "bad");

function vitalTile(v, stat) {
  const p75 = stat ? num(stat.p75) : null;
  const split = stat && ["mobile", "desktop"].filter((d) => stat[d] && num(stat[d].p75) != null)
    .map((d) => d + " " + vitalValue(v, stat[d].p75)).join(" · ");
  const title = v.what + (stat ? ": p75 of " + stat.n + " samples (p50 " + vitalValue(v, num(stat.p50)) + ", p95 " + vitalValue(v, num(stat.p95)) + ")" : ": no samples");
  return (
    '<div class="vt r-' + rating(v, p75) + '" title="' + escape(title) + '"><span>' + v.key + "</span><b>" + vitalValue(v, p75) + "</b>" +
    "<small>" + (stat ? escape(split || count(stat.n) + " samples") : "no data") + "</small></div>"
  );
}

function routeRows(routes) {
  if (!routes.length) return "";
  const cell = (key, value) => {
    const v = VITALS.find((x) => x.key === key);
    return '<td class="r-' + rating(v, num(value)) + '">' + vitalValue(v, num(value)) + "</td>";
  };
  return (
    '<table class="mxt"><thead><tr><th>Route</th><th>Views</th><th title="p75">LCP</th><th title="p75">NAV</th><th title="p75">INP</th></tr></thead><tbody>' +
    routes.map((r) => "<tr><td><code>" + escape(r.route) + "</code></td><td>" + count(num(r.views) || 0) + "</td>" + cell("LCP", r.LCP) + cell("NAV", r.NAV) + cell("INP", r.INP) + "</tr>").join("") +
    "</tbody></table>"
  );
}

function errorRows(errors, total) {
  if (!errors.length) return '<p class="mx-ok">No errors.</p>';
  return (
    '<ul class="mxe">' +
    errors.slice(0, 5).map((e) =>
      '<li><span class="rc" style="--c: var(--' + (e.kind === "server" ? "bad" : "warn") + ')">' + escape(e.kind) + "</span>" +
      "<div><b>" + escape(e.name) + "</b> " + escape(e.message) +
      "<small><code>" + escape(e.route) + "</code>" + (e.source ? " · " + escape(e.source) : "") + " · " + count(num(e.count) || 0) + "× · last " +
      (Date.parse(e.last_seen) ? when(Date.parse(e.last_seen)) : "–") + "</small></div></li>").join("") +
    "</ul>" + (total > errors.slice(0, 5).reduce((a, e) => a + (num(e.count) || 0), 0) ? '<small class="foot">' + count(total) + " errors in all</small>" : "")
  );
}

// Daily views of the last 30 days as bars, the LCP p75 in each bar's tooltip
function sparkline(daily) {
  const days = daily.slice(-30);
  if (!days.length) return "";
  const max = Math.max(1, ...days.map((d) => num(d.views) || 0));
  const w = 100 / 30;
  const bars = days.map((d, i) => {
    const h = Math.max(2, ((num(d.views) || 0) / max) * 36);
    const x = (30 - days.length + i) * w;
    const label = new Date(Date.parse(d.day)).toISOString().slice(0, 10) + ": " + (num(d.views) || 0) + " views" +
      (num(d.lcp_p75) != null ? ", LCP p75 " + vitalValue(VITALS[0], d.lcp_p75) : "");
    return '<rect x="' + (x + w * 0.15).toFixed(2) + '" y="' + (40 - h).toFixed(1) + '" width="' + (w * 0.7).toFixed(2) + '" height="' + h.toFixed(1) + '" rx="0.6"><title>' + escape(label) + "</title></rect>";
  }).join("");
  return '<svg class="spark" viewBox="0 0 100 40" preserveAspectRatio="none" role="img" aria-label="Views per day, last 30 days">' + bars + "</svg>";
}

function metricsCard(name, app) {
  const ranges = RANGES.map(([key]) => {
    const r = app.ranges && app.ranges[key];
    if (!r || !(r.views || Object.keys(r.vitals || {}).length || (r.errors || []).length)) {
      return '<div class="rg" data-r="' + key + '"><p class="mx-ok">Nothing in this range yet.</p></div>';
    }
    const dev = r.devices || {};
    return (
      '<div class="rg" data-r="' + key + '">' +
      '<div class="mx-n"><b>' + count(num(r.views) || 0) + "</b> views" +
      '<span>' + count(num(dev.mobile) || 0) + " mobile · " + count(num(dev.desktop) || 0) + " desktop</span>" +
      '<span class="' + (r.error_count ? "bad" : "good") + '">' + count(num(r.error_count) || 0) + (r.error_count === 1 ? " error" : " errors") + "</span></div>" +
      '<div class="vts">' + VITALS.map((v) => vitalTile(v, r.vitals && r.vitals[v.key])).join("") + "</div>" +
      routeRows(Array.isArray(r.routes) ? r.routes : []) +
      "<h4>Errors</h4>" + errorRows(Array.isArray(r.errors) ? r.errors : [], num(r.error_count) || 0) +
      "</div>"
    );
  }).join("");
  return (
    '<section class="mx-card glass"><div class="bk-h"><span class="gi" style="--c: var(--metrics)">' + icon("metrics") + "</span><b>" + escape(name) + "</b>" +
    '<span class="n">last 30 days</span></div>' + sparkline(Array.isArray(app.daily) ? app.daily : []) + ranges + "</section>"
  );
}

function metricsSection(m) {
  if (!m.container) {
    return '<div class="glass empty">' + escape(METRICS_CONTAINER) + " is not running here, so the apps' metrics aren't collected.</div>";
  }
  const s = m.summary;
  if (!s) return '<div class="glass empty">No metrics summary yet: ' + escape(METRICS_CONTAINER) + " writes it a minute after it starts.</div>";
  const names = Object.keys(s.apps).sort();
  if (!names.length) return '<div class="glass empty">No app sends metrics yet: <code>scripts/new-project.sh &lt;app&gt; --metrics</code></div>';
  const keep = s.retention || {};
  const generated = Date.parse(s.generated_at);
  return (
    '<div class="mx" data-sel="24h"><div class="mx-r" role="group" aria-label="Range">' +
    RANGES.map(([key, label]) => '<button type="button" data-range="' + key + '" aria-pressed="' + (key === "24h") + '">' + label + "</button>").join("") +
    "</div>" + '<div class="mxs">' + names.map((n) => metricsCard(n, s.apps[n] || {})).join("") + "</div></div>" +
    '<p class="intg-note">p75 per metric; green, amber and red follow the Web Vitals thresholds. Anonymous: route patterns, no IP, cookie or user id. ' +
    "Kept " + (keep.hourlyDays || "?") + " days by hour, " + (keep.dailyDays || "?") + " days by day (errors " + (keep.errorDays || "?") + ")." +
    (generated ? " Summary from " + when(generated) + "." : "") + "</p>"
  );
}

// ---- speed test section (outside #live: it has its own polling while a test runs)
const mbps = (n) => (n >= 100 ? n.toFixed(0) : n >= 10 ? n.toFixed(1) : n.toFixed(2)) + " Mbps";

function speedTile(label, value, note) {
  return (
    '<div class="vt" style="--rc: var(--speed)"><span>' + label + "</span><b>" + (value == null ? "–" : value) + "</b><small>" + (note || "&nbsp;") + "</small></div>"
  );
}

// What GET /speedtest sends and the page shows: the tiles, then the button's status line
function speedBody() {
  const src = speed.running ? speed.current : speed.last || {};
  const num2 = (n) => (typeof n === "number" && Number.isFinite(n) ? n : null);
  const ping = num2(src.ping), down = num2(src.download), up = num2(src.upload);
  const tiles =
    '<div class="vts">' +
    speedTile("PING", ping == null ? null : ping.toFixed(ping >= 100 ? 0 : 1) + " ms", num2(src.jitter) == null ? "" : "jitter " + src.jitter.toFixed(1) + " ms" + (src.via ? " · " + (src.via === "icmp" ? "ICMP" : "HTTPS") : "")) +
    speedTile("DOWNLOAD", down == null ? null : mbps(down), "") +
    speedTile("UPLOAD", up == null ? null : mbps(up), "") +
    "</div>";
  let status;
  if (speed.running) status = "Measuring " + escape(speed.phase || "ping") + "…";
  else if (!speed.last) status = "No test since this app started.";
  else if (speed.last.ok) status = "Measured " + when(speed.last.at) + ".";
  else status = '<span class="bad">The last test failed (' + escape(speed.last.error) + ")</span>, " + when(speed.last.at) + ".";
  return tiles + '<div class="sp-a"><button type="button" class="btn" id="sp-run" style="--c: var(--speed)"' + (speed.running ? " disabled" : "") + ">" +
    icon("speed") + (speed.running ? "Testing…" : "Run speed test") + '</button><span id="sp-msg" role="status" aria-live="polite">' + status + "</span></div>";
}

function speedSection() {
  return (
    "<h2>Internet speed</h2>" +
    '<section class="glass sp"><div class="bk-h"><span class="gi" style="--c: var(--speed)">' + icon("speed") + "</span><b>Raspberry Pi to the internet</b>" +
    '<span class="n">on demand</span></div><div id="sp-body">' + speedBody() + "</div>" +
    '<p class="intg-note" style="margin-left: 0">Runs only when you press the button (about ' + SPEED_SECONDS + " s each for download and upload, at most " +
    Math.round(SPEED_MAX_BYTES / 1e6) + " MB per direction) against Cloudflare's speed-test servers. Ping is ICMP to 1.1.1.1 (the HTTPS round trip to Cloudflare if ICMP is blocked). " +
    "Apps on the Pi share the line, so it may read lower while they are busy.</p></section>"
  );
}

// One banner per pinned image with a newer release
function updateBanners(updates) {
  return [...updates.values()]
    .map(
      (u) =>
        '<div class="upd glass" style="--c: var(--' + u.check.c + ')"><span class="gi">' + mark(u.check.brand) + "</span><div>" +
        "<b>" + escape(u.check.name + " " + u.latest) + " is available</b><small>running " + escape(u.running) + "</small>" +
        "<p>Set " + chip(null, u.check.env + "=" + u.latest) + " in LocalInfra's <kbd>.env</kbd>, then run " + chip(null, "./deploy.sh " + u.check.service) + "</p></div>" +
        '<a class="btn" href="' + escape(u.check.notes) + '" target="_blank" rel="noopener noreferrer">' + icon("out") + "Release notes</a></div>",
    )
    .join("");
}

// The part of the page that refreshes itself (GET /live every 15s)
async function livePart() {
  try {
    const snap = await snapshot();
    const [mem, versions, updates, backed, metrics] = await Promise.all([
      memoryFor(snap.containers),
      versionsFor(snap.containers),
      updatesFor(snap),
      backups(snap),
      metricsSummary(snap),
    ]);
    return {
      snap,
      html:
        tiles(snap, mem) + updateBanners(updates) +
        "<h2>Resource map</h2>" + resourceMap(snap, mem) +
        "<h2>Projects</h2>" +
        (snap.projects.length
          ? snap.projects.map((p) => projectCard(p, mem, versions, updates)).join("")
          : '<div class="glass empty">No containers of yours yet.</div>') +
        "<h2>Metrics</h2>" + metricsSection(metrics) +
        "<h2>Backups</h2>" + backupSection(backed),
    };
  } catch (error) {
    return { snap: null, html: '<div class="glass empty">❗ Docker unavailable: ' + escape(error.message) + "</div>" };
  }
}

