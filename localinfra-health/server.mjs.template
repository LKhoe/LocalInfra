const resourceStyle = (r) => "--c: var(--" + r.key + ")";

function memoryCell(reading) {
  if (!reading) return '<div class="mem"><span><em>–</em></span></div>';
  const whole = reading.limit || os.totalmem();
  const share = reading.used / whole;
  return (
    '<div class="mem" title="' + (reading.limit ? "Memory limit " + bytes(reading.limit) : "No memory limit: share of the Pi's memory") + '">' +
    "<span>" + bytes(reading.used) + (reading.limit ? "<em> / " + bytes(reading.limit) + "</em>" : "") + "</span>" +
    '<i class="bar' + (share > 0.85 ? " hot" : "") + '"><i style="width:' + pct(reading.used, whole) + '%"></i></i></div>'
  );
}

function tiles(snap, mem) {
  const t = totals(snap);
  let mine = 0;
  for (const c of snap.containers) mine += mem.get(c.id)?.used || 0;
  const total = os.totalmem();
  const hostUsed = total - os.freemem();
  const tile = (cls, k, value, of, sub, extra) =>
    '<div class="tile glass' + (cls ? " " + cls : "") + '"><span class="k">' + k + "</span><b>" + value +
    (of != null ? "<em>/" + of + "</em>" : "") + '</b><span class="s">' + sub + "</span>" + (extra || "") + "</div>";
  return (
    '<div class="tiles">' +
    tile("", "Containers", t.okContainers, t.containers, "healthy") +
    tile("", "Projects", t.okProjects, t.projects, "healthy") +
    tile(t.issues ? "bad" : "good", "Issues", t.issues, null, t.issues ? "need a look" : "all clear") +
    tile("", "Memory", escape(bytes(mine)), null, "Pi " + bytes(hostUsed) + " / " + bytes(total),
      '<i class="bar"><i class="host" style="width:' + pct(hostUsed, total) + '%"></i><i style="width:' + pct(mine, total) + '%"></i></i>') +
    "</div>"
  );
}

function resourceMap(snap, mem) {
  const byName = new Map(snap.containers.map((c) => [c.name, c]));
  const apps = snap.containers
    .filter((c) => c.uses.length)
    .sort((a, b) => (a.project || a.name).localeCompare(b.project || b.name) || a.name.localeCompare(b.name));
  if (!apps.length) {
    return '<div class="glass empty">No container uses LocalInfra yet. Join a <code>localinfra_*</code> network to show up here.</div>';
  }
  const H = Math.max(apps.length * 58, RESOURCES.length * 66);
  const yApp = (i) => ((i + 0.5) * H) / apps.length;
  const yRes = (j) => ((j + 0.5) * H) / RESOURCES.length;

  let edges = "";
  apps.forEach((c, i) => {
    for (const key of c.uses) {
      const j = RESOURCES.findIndex((r) => r.key === key);
      const a = yApp(i).toFixed(1);
      const b = yRes(j).toFixed(1);
      const d = "M0 " + a + " C50 " + a + " 50 " + b + " 100 " + b;
      const data = ' data-app="' + escape(c.name) + '" data-res="' + key + '" stroke="var(--' + key + ')"';
      edges += ["glow", "line", "flow"].map((cls) => '<path class="' + cls + '" d="' + d + '"' + data + "/>").join("");
    }
  });

  const left = apps
    .map((c) => {
      const sub = c.project && c.project !== c.name ? c.project : "";
      return (
        '<div class="pill" data-app="' + escape(c.name) + '" title="' + escape(c.name + " · " + c.status) + '"><span class="dot st-' + c.state + '"></span>' +
        appIcon(c) + '<span class="t"><b>' + escape(c.name) + "</b>" + (sub ? "<small>" + escape(sub) + "</small>" : "") + "</span></div>"
      );
    })
    .join("");

  const right = RESOURCES.map((r) => {
    const provider = byName.get(r.provider);
    const users = apps.filter((c) => c.uses.includes(r.key)).length;
    const reading = provider && mem.get(provider.id);
    const sub = users + (users === 1 ? " app" : " apps") + (reading ? " · " + bytes(reading.used) : "");
    const state = provider ? provider.state : "unknown";
    return (
      '<div class="pill res" data-res="' + r.key + '" style="' + resourceStyle(r) + '" title="' +
      escape((provider ? provider.name + " · " + provider.status : r.label + ": container not found") + " · network " + r.network) + '">' +
      '<span class="ico">' + icon(r.key) + '</span><span class="t"><b>' + r.label + "</b><small>" + sub + "</small></span>" +
      '<span class="dot st-' + state + '"></span></div>'
    );
  }).join("");

  return (
    '<div class="map glass" style="--h:' + H + 'px">' +
    '<div class="col l">' + left + "</div>" +
    '<svg class="edges" viewBox="0 0 100 ' + H + '" preserveAspectRatio="none" aria-hidden="true">' + edges + "</svg>" +
    '<div class="col r">' + right + "</div></div>"
  );
}

function containerRow(c, mem) {
  const chips = c.uses
    .map((key) => {
      const r = RESOURCES.find((x) => x.key === key);
      return '<span class="rc" style="' + resourceStyle(r) + '" title="' + r.label + " (" + r.network + ')">' + r.short + "</span>";
    })
    .join("");
  return (
    '<li class="row st-' + c.state + '"><span class="dot"></span>' +
    '<div class="who"><span class="nm"><b>' + escape(c.name) + "</b>" + appLink(c, "url") + "</span><small>" + escape(c.status) + "</small></div>" +
    '<div class="chips">' + chips + "</div>" + memoryCell(mem.get(c.id)) + "</li>"
  );
}

function projectCard(p, mem) {
  let used = 0;
  for (const c of p.containers) used += mem.get(c.id)?.used || 0;
  return (
    '<section class="proj glass"><div class="proj-h"><span class="dot st-' + p.state + '"></span><h3>' + escape(p.name) + "</h3>" +
    '<span class="n">' + p.ok + "/" + p.containers.length + " healthy</span>" +
    '<span class="m">' + (used ? bytes(used) : "") + "</span></div>" +
    '<ul class="rows">' + p.containers.map((c) => containerRow(c, mem)).join("") + "</ul></section>"
  );
}

// The part of the page that refreshes itself (GET /live every 15s)
async function livePart() {
  try {
    const snap = await snapshot();
    const mem = await memoryFor(snap.containers);
    return {
      snap,
      html:
        tiles(snap, mem) +
        "<h2>Resource map</h2>" + resourceMap(snap, mem) +
        "<h2>Projects</h2>" +
        (snap.projects.length
          ? snap.projects.map((p) => projectCard(p, mem)).join("")
          : '<div class="glass empty">No containers of yours yet.</div>'),
    };
  } catch (error) {
    return { snap: null, html: '<div class="glass empty">❗ Docker unavailable: ' + escape(error.message) + "</div>" };
  }
}

const chip = (key, fallback) =>
  '<span class="chip' + (key ? '" data-chip="' + key : "") + '"><code' + (key ? ' data-k="' + key + '"' : "") + ">" + escape(fallback) + "</code>" +
  '<button type="button" class="cp" title="Copy" aria-label="Copy">' + icon("copy", "cp-i") + icon("check", "ok") + "</button></span>";

function guides(snap) {
  const apps = (snap ? snap.containers : []).filter((c) => c.project !== "localinfra" && !RESOURCES.some((r) => r.provider === c.name));
  // Suggest the domain the published apps already use
  let domain = "";
  for (const c of apps) {
    const host = c.url && hostname(c.url);
    if (host && host.split(".").length > 2) {
      domain = host.split(".").slice(1).join(".");
      break;
    }
  }
  const options = apps.length
    ? apps
        .map((c) => {
          const host = c.url && hostname(c.url);
          return (
            '<option value="' + escape(c.name) + '" data-port="' + c.port + '" data-tunnel="' + (c.uses.includes("tunnel") ? 1 : 0) + '"' +
            (host ? ' data-sub="' + escape(host.split(".")[0]) + '"' : "") + ">" + escape(c.name) + "</option>"
          );
        })
        .join("")
    : '<option value="myapp" data-port="3000" data-tunnel="1">myapp</option>';

  const cloudflare =
    '<details class="guide glass" style="--c: var(--tunnel)" id="guide-cloudflare">' +
    '<summary><span class="gi">' + icon("tunnel") + "</span><div><b>Publish an app on Cloudflare</b>" +
    "<small>Add a route to the tunnel so the app gets a public HTTPS address</small></div>" + icon("chevron", "chev") + "</summary>" +
    '<div class="gbody">' +
    '<a class="btn" href="https://one.dash.cloudflare.com/" target="_blank" rel="noopener noreferrer">' + icon("out") + "Open Cloudflare Zero Trust</a>" +
    '<ol class="steps">' +
    '<li class="warn" data-if="notunnel" hidden>This container is not on ' + chip(null, "localinfra_tunnel") +
    ', so the tunnel can\'t reach it. Add it to the networks in the app\'s compose file and run <kbd>./deploy.sh</kbd>.</li>' +
    "<li>In Zero Trust go to <b>Networks → Tunnels</b> and open the LocalInfra tunnel (the one <kbd>localinfra-tunnel</kbd> runs).</li>" +
    "<li>Open the <b>Published application routes</b> tab and click <b>Add a published application route</b>.</li>" +
    "<li>Subdomain " + chip("sub", "myapp") + " Domain " + chip("domain", "example.com") +
    '<span class="note">Leave Path empty.</span></li>' +
    "<li>Service type " + chip(null, "HTTP") + " URL " + chip("svc", "myapp:3000") +
    '<span class="note">The container name and its internal port, not the LAN port.</span></li>' +
    "<li>Click <b>Save</b>. In a few seconds the app answers on " + chip("origin", "https://myapp.example.com") + "</li>" +
    "<li>Put the address in the app's <kbd>.env</kbd> and run <kbd>./deploy.sh</kbd> " + chip("envurl", "NEXT_PUBLIC_APP_URL=https://myapp.example.com") +
    '<span class="note">Also BETTER_AUTH_URL if the app has it. NEXT_PUBLIC_* is baked in at build time, so a redeploy is needed.</span></li>' +
    "</ol></div></details>";

  const google =
    '<details class="guide glass" style="--c: var(--postgres)" id="guide-google">' +
    '<summary><span class="gi">' + icon("google") + "</span><div><b>Add Google sign-in</b>" +
    "<small>Create an OAuth client in Google Cloud Console</small></div>" + icon("chevron", "chev") + "</summary>" +
    '<div class="gbody">' +
    '<a class="btn" href="https://console.cloud.google.com/auth/clients" target="_blank" rel="noopener noreferrer">' + icon("out") + "Open Google Cloud Console</a>" +
    '<ol class="steps">' +
    "<li>Pick the project in the top bar, or create one for the app.</li>" +
    "<li><b>Google Auth Platform → Branding</b>: app name and support email. Under Authorized domains add " + chip("domain", "example.com") +
    '<span class="note">The first time, this is the Get started wizard.</span></li>' +
    "<li><b>Audience</b>: External. While it says Testing, only the test users listed there can sign in; <b>Publish app</b> opens it to everyone." +
    '<span class="note">Email and profile scopes need no Google review.</span></li>' +
    "<li><b>Clients → Create client</b>, type " + chip(null, "Web application") + " name " + chip("name", "myapp") + "</li>" +
    "<li>Authorized JavaScript origins → Add URI " + chip("origin", "https://myapp.example.com") + "</li>" +
    "<li>Authorized redirect URIs → Add URI " + chip("redirect", "https://myapp.example.com/api/auth/callback/google") +
    '<span class="note">For local dev, add http://localhost:3000 and http://localhost:3000/api/auth/callback/google too.</span></li>' +
    "<li>Click <b>Create</b> and copy both values into the app's <kbd>.env</kbd> right away, the secret is shown only once. " +
    chip(null, "GOOGLE_CLIENT_ID") + " " + chip(null, "GOOGLE_CLIENT_SECRET") + " Then <kbd>./deploy.sh</kbd>.</li>" +
    "</ol></div></details>";

  return (
    '<div class="ghead"><h2>Guides</h2>' +
    '<label class="field"><span>App</span><select id="g-app">' + options + "</select></label>" +
    '<label class="field"><span>Domain</span><input id="g-domain" placeholder="example.com" spellcheck="false" autocomplete="off" value="' +
    escape(domain) + '"></label></div>' +
    cloudflare + google
  );
}

// Client side: refresh the live part, map highlighting, guide values, copy buttons
const SCRIPT = [
  "(function () {",
  "  var live = document.getElementById('live'), beat = document.getElementById('beat'), stamp = document.getElementById('stamp');",
  "  function now() { stamp.textContent = 'updated ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }); }",
  "  function refresh() {",
  "    if (document.hidden) return;",
  "    fetch('live', { cache: 'no-store' }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })",
  "      .then(function (html) { live.innerHTML = html; beat.classList.remove('off'); now(); })",
  "      .catch(function () { beat.classList.add('off'); stamp.textContent = 'offline, retrying'; });",
  "  }",
  "  now();",
  "  setInterval(refresh, 15000);",
  "  document.addEventListener('visibilitychange', refresh);",
  "",
  "  // Hover an app or a resource on the map: light up its links, dim the rest",
  "  function focus(node) {",
  "    var map = live.querySelector('.map'); if (!map) return;",
  "    map.classList.toggle('focus', !!node);",
  "    if (!node) return;",
  "    var app = node.getAttribute('data-app'), res = node.getAttribute('data-res');",
  "    var linked = function (a, r) { return app ? a === app : r === res; };",
  "    map.querySelectorAll('path').forEach(function (p) { p.classList.toggle('on', linked(p.getAttribute('data-app'), p.getAttribute('data-res'))); });",
  "    map.querySelectorAll('.pill').forEach(function (el) {",
  "      var on = el === node || !!map.querySelector(el.hasAttribute('data-app')",
  "        ? 'path.on[data-app=\"' + CSS.escape(el.getAttribute('data-app')) + '\"]'",
  "        : 'path.on[data-res=\"' + el.getAttribute('data-res') + '\"]');",
  "      el.classList.toggle('on', on);",
  "    });",
  "  }",
  "  live.addEventListener('mouseover', function (e) { focus(e.target.closest('.map .pill')); });",
  "  live.addEventListener('mouseleave', function () { focus(null); });",
  "",
  "  var app = document.getElementById('g-app'), dom = document.getElementById('g-domain');",
  "  function load(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }",
  "  function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }",
  "  var savedApp = load('lih.app'), savedDomain = load('lih.domain');",
  "  if (savedApp && app.querySelector('option[value=\"' + CSS.escape(savedApp) + '\"]')) app.value = savedApp;",
  "  if (savedDomain) dom.value = savedDomain;",
  "  function fill() {",
  "    var o = app.options[app.selectedIndex], name = o ? o.value : 'myapp';",
  "    var sub = (o && o.getAttribute('data-sub')) || name, d = dom.value.trim().toLowerCase(), real = !!d;",
  "    d = d || 'example.com';",
  "    var origin = 'https://' + sub + '.' + d;",
  "    var v = { name: name, sub: sub, domain: d, svc: name + ':' + ((o && o.getAttribute('data-port')) || '3000'), origin: origin,",
  "      redirect: origin + '/api/auth/callback/google', envurl: 'NEXT_PUBLIC_APP_URL=' + origin };",
  "    document.querySelectorAll('[data-k]').forEach(function (el) {",
  "      var k = el.getAttribute('data-k'); el.textContent = v[k];",
  "      el.parentNode.classList.toggle('ph', !real && k !== 'name' && k !== 'svc' && k !== 'sub');",
  "    });",
  "    document.querySelectorAll('[data-if=\"notunnel\"]').forEach(function (el) { el.hidden = !o || o.getAttribute('data-tunnel') === '1'; });",
  "  }",
  "  app.addEventListener('change', function () { save('lih.app', app.value); fill(); });",
  "  dom.addEventListener('input', function () { save('lih.domain', dom.value.trim()); fill(); });",
  "  fill();",
  "",
  "  // http://umbrel.local is not a secure context, so navigator.clipboard is often missing",
  "  // and if the browser refuses both ways the value is left selected for a manual copy",
  "  function copy(code, done) {",
  "    var text = code.textContent;",
  "    function select() { var r = document.createRange(); r.selectNodeContents(code); var s = getSelection(); s.removeAllRanges(); s.addRange(r); }",
  "    function legacy() {",
  "      var t = document.createElement('textarea'), ok = false; t.value = text; t.setAttribute('readonly', '');",
  "      t.style.position = 'fixed'; t.style.opacity = '0'; document.body.appendChild(t); t.select();",
  "      try { ok = document.execCommand('copy'); } catch (e) {}",
  "      document.body.removeChild(t);",
  "      if (ok) done(); else select();",
  "    }",
  "    if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(done, legacy); else legacy();",
  "  }",
  "  document.addEventListener('click', function (e) {",
  "    var b = e.target.closest('.cp'); if (!b) return;",
  "    copy(b.parentNode.querySelector('code'), function () {",
  "      b.classList.add('done'); setTimeout(function () { b.classList.remove('done'); }, 1400);",
  "    });",
  "  });",
  "})();",
].join("\n");

