          "<li><b>Echo Show</b>: " + escape(s.screen) + "</li>" +
          "<li><b>Voice</b>: " + escape(s.voice) + "</li>" +
          "<li><b>Permissions</b>: " + escape(s.permissions) + "</li>" +
          "<li>" + escape(s.after) + "</li></ul></div>",
      )
      .join("") +
    '<div class="app-note" data-for-none hidden>This app has no Alexa skill. The ones that do: ' + Object.keys(ALEXA_SKILLS).sort().join(", ") + ".</div>";

  const alexa =
