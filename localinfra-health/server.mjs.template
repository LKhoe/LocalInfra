  '<path d="M9 33h9l6-17 10 32 6-15h15" stroke-width="6"/>',
  "</g></svg>",
].join("");

const icon = (name, cls) =>
  '<svg class="ic' + (cls ? " " + cls : "") + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
  ICONS[name] + "</svg>";

const brand = (name, cls) =>
  '<svg class="ic brand' + (cls ? " " + cls : "") + '" viewBox="0 0 24 24" aria-hidden="true">' +
  BRANDS[name].map(([fill, d, extra]) => '<path fill="' + fill + '" d="' + d + '"' + (extra || "") + "/>").join("") + "</svg>";

// A brand logo when there is one, else the stroke icon
const mark = (name, cls) => (BRANDS[name] ? brand(name, cls) : icon(name, cls));

