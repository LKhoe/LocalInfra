// Container Health: umbrelOS widgets + a status page for the containers you run
// yourself (LocalInfra, your projects), skipping the ones umbrelOS manages.
//
// Read-only by design: the only Docker API calls are GET /containers/json and, for
// the status page only, GET /containers/<id>/stats (one-shot memory reading).
// The status page also shows each app's icon, fetched from its public address.
// No dependencies; runs on a stock node:alpine image.
//
// This is a ".template" because umbrelOS app updates only copy whitelisted
// files (docker-compose.yml, *.template, ...). Templates are rendered with
// envsubst, so this file must NOT contain the dollar sign at all: no template
// literals, no regex end anchors. scripts/check-health-app.sh enforces it.
import http from "node:http";
import os from "node:os";

const PORT = Number(process.env.PORT || 3000);
const DOCKER_SOCKET = process.env.DOCKER_SOCKET || "/var/run/docker.sock";
// Containers umbrelOS starts carry this compose working dir; yours carry the
// folder you deployed from (e.g. /Users/you/Code/project), so they stay visible.
const EXCLUDE_WORKDIR_PREFIXES = (process.env.EXCLUDE_WORKDIR_PREFIXES || "/opt/umbreld/")
  .split(",")
  .map((s) => s.trim())
  .filter(Boolean);
// Opt-out for one-off containers: docker run --label localinfra.health.hide=true ...
const HIDE_LABEL = "localinfra.health.hide";
// Optional public URL of an app (the app template sets it from NEXT_PUBLIC_APP_URL)
const URL_LABEL = "localinfra.url";
const REFRESH = process.env.WIDGET_REFRESH || "30s";
// Memory readings are shared by every open status page for this long
const MEMORY_TTL_MS = 10000;
// App icons (fetched from each app's public address) are kept this long
const SITE_ICON_TTL_MS = 12 * 3600 * 1000;
const SITE_ICON_RETRY_MS = 10 * 60 * 1000;
const SITE_ICON_MAX_BYTES = 256 * 1024;

const STATES = {
  ok: { rank: 0, emoji: "✅", label: "Healthy" },
  starting: { rank: 1, emoji: "⏳", label: "Starting" },
  unhealthy: { rank: 2, emoji: "⚠️", label: "Unhealthy" },
  stopped: { rank: 3, emoji: "❌", label: "Stopped" },
};

// What LocalInfra provides. A container uses a resource when it joins its network.
const RESOURCES = [
  { key: "postgres", label: "Postgres", short: "PG", network: "localinfra_postgres", provider: "localinfra-postgres" },
  { key: "redis", label: "Redis", short: "RD", network: "localinfra_redis", provider: "localinfra-redis" },
  { key: "s3", label: "S3", short: "S3", network: "localinfra_s3", provider: "localinfra-s3" },
  { key: "llm", label: "LLM", short: "AI", network: "localinfra_llm", provider: "localinfra-llm" },
  // Every app on this network can be reached by the Cloudflare tunnel
  { key: "tunnel", label: "Tunnel", short: "CF", network: "localinfra_tunnel", provider: "localinfra-tunnel" },
];

function dockerGet(path) {
  return new Promise((resolve, reject) => {
    const req = http.request(
      { socketPath: DOCKER_SOCKET, path, method: "GET", timeout: 5000 },
      (res) => {
        let body = "";
        res.setEncoding("utf8");
        res.on("data", (chunk) => (body += chunk));
        res.on("end", () => {
          if (res.statusCode !== 200) return reject(new Error("Docker API " + res.statusCode));
          try {
            resolve(JSON.parse(body));
          } catch (error) {
            reject(error);
          }
        });
      },
    );
    req.on("timeout", () => req.destroy(new Error("Docker API timeout")));
    req.on("error", reject);
    req.end();
  });
}

function classify(container) {
  const status = container.Status || "";
  switch (container.State) {
    case "running":
      if (/\(unhealthy\)/.test(status)) return "unhealthy";
      if (/\(health: starting\)/.test(status)) return "starting";
      return "ok";
    case "restarting": // a restart loop is a problem, not progress
      return "unhealthy";
    default: // created, exited, paused, dead, removing
      return "stopped";
  }
}

function isMine(container) {
  const labels = container.Labels || {};
  if (labels[HIDE_LABEL] === "true") return false;
  const workdir = labels["com.docker.compose.project.working_dir"] || "";
  return !EXCLUDE_WORKDIR_PREFIXES.some((prefix) => workdir.startsWith(prefix));
}

const worst = (states) =>
  states.reduce((a, b) => (STATES[b].rank > STATES[a].rank ? b : a), "ok");

function describe(c) {
  const name = (c.Names?.[0] || c.Id.slice(0, 12)).replace(/^\//, "");
  const networks = Object.keys(c.NetworkSettings?.Networks || {});
  return {
    id: c.Id,
    name,
    project: c.Labels?.["com.docker.compose.project"] || null,
    state: classify(c),
    running: c.State === "running" || c.State === "restarting",
    status: c.Status || c.State,
    image: c.Image,
    url: c.Labels?.[URL_LABEL] || null,
    port: (c.Ports || []).find((p) => p.Type === "tcp")?.PrivatePort || 3000,
    // A provider doesn't "use" its own network
    uses: RESOURCES.filter((r) => networks.includes(r.network) && r.provider !== name).map((r) => r.key),
  };
}

async function snapshot() {
  const list = await dockerGet("/containers/json?all=true");
  const containers = list.filter(isMine).map(describe);

  // One group per compose project; containers outside compose stand alone
  const groups = new Map();
  for (const c of containers) {
    const key = c.project || c.name;
    if (!groups.has(key)) groups.set(key, { name: key, containers: [] });
    groups.get(key).containers.push(c);
  }
  const projects = [...groups.values()]
    .map((g) => ({
      ...g,
      state: worst(g.containers.map((c) => c.state)),
      ok: g.containers.filter((c) => c.state === "ok").length,
      containers: g.containers.sort((a, b) => STATES[b.state].rank - STATES[a.state].rank || a.name.localeCompare(b.name)),
    }))
    // Problems first, so they stay visible in a small widget
    .sort((a, b) => STATES[b.state].rank - STATES[a.state].rank || a.name.localeCompare(b.name));

  const counts = { ok: 0, starting: 0, unhealthy: 0, stopped: 0 };
  for (const c of containers) counts[c.state]++;

  return { projects, containers, counts };
}

// ---------------------------------------------------------------- memory
// One one-shot stats call per running container, only while a status page is
// open, cached for MEMORY_TTL_MS and at most 4 calls at a time.

let memoryCache = { at: 0, byId: new Map(), pending: null };

async function readMemory(id) {
  const s = await dockerGet("/containers/" + id + "/stats?stream=false&one-shot=true");
  const m = s.memory_stats || {};
  const st = m.stats || {};
  // Same number as `docker stats`: usage minus the page cache that can be dropped
  const cache = st.inactive_file ?? st.total_inactive_file ?? 0;
  const used = Math.max(0, (m.usage || 0) - cache);
  // Without a limit Docker reports the host's memory
  const limit = m.limit && m.limit < os.totalmem() * 0.98 ? m.limit : null;
  return m.usage == null ? null : { used, limit };
}

async function memoryFor(targets) {
  if (Date.now() - memoryCache.at < MEMORY_TTL_MS) return memoryCache.byId;
  if (memoryCache.pending) return memoryCache.pending;
  memoryCache.pending = (async () => {
    const byId = new Map();
    const queue = targets.filter((c) => c && c.running);
    const worker = async () => {
      while (queue.length) {
        const c = queue.shift();
        try {
          const reading = await readMemory(c.id);
          if (reading) byId.set(c.id, reading);
        } catch {
          // left blank on the page
        }
      }
    };
    await Promise.all([worker(), worker(), worker(), worker()]);
    memoryCache = { at: Date.now(), byId, pending: null };
    return byId;
  })().finally(() => (memoryCache.pending = null));
  return memoryCache.pending;
}

// ---------------------------------------------------------------- app icons
// The resource map shows each app's own icon. Apps declare it in different places
// (<link rel="icon"> with an .svg, a .png, a 1024px .ico...), so the server reads the
// app's page once, picks the best one, and keeps it in memory. Only addresses from the
// localinfra.url label are ever fetched.

const GLOBE =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
  '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.6 3.5 5.4 3.5 8.5s-1.1 5.9-3.5 8.5c-2.4-2.6-3.5-5.4-3.5-8.5S9.6 6.1 12 3.5z"/></svg>';

// page address -> { at, type, body } (no body = no usable icon) or { pending }
const siteIcons = new Map();

const attr = (tag, name) => {
  const m = tag.match(new RegExp("\\s" + name + "\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))", "i"));
  return m ? (m[1] ?? m[2] ?? m[3]).replace(/&amp;/g, "&") : null;
};

// Best first: SVG, then a 32-256px bitmap, any other bitmap, apple-touch-icon, .ico
function iconCandidates(html, page) {
  const found = [];
  for (const tag of html.match(/<link\b[^>]*>/gi) || []) {
    const rel = (attr(tag, "rel") || "").toLowerCase().split(/\s+/);
    const href = attr(tag, "href");
    if (!href || !(rel.includes("icon") || rel.includes("apple-touch-icon"))) continue;
    let url;
    try {
      url = new URL(href, page);
    } catch {
      continue;
    }
    if (url.protocol !== "https:" && url.protocol !== "http:") continue;
    const type = (attr(tag, "type") || "").toLowerCase();
    const path = url.pathname.toLowerCase();
    const size = Number(((attr(tag, "sizes") || "").match(/\d+/) || [])[0]) || 0;
    let rank;
    if (type.includes("svg") || path.endsWith(".svg")) rank = 0;
    else if (type.includes("icon") || path.endsWith(".ico")) rank = 4;
    else if (rel.includes("apple-touch-icon")) rank = 3;
    else rank = size >= 32 && size <= 256 ? 1 : 2;
    found.push({ url: url.href, rank, size });
  }
  found.sort((a, b) => a.rank - b.rank || Math.abs(a.size - 64) - Math.abs(b.size - 64));
  const urls = found.map((f) => f.url);
  urls.push(new URL("/favicon.ico", page).href);
  return [...new Set(urls)];
}

async function download(url) {
  const res = await fetch(url, { signal: AbortSignal.timeout(5000), headers: { accept: "image/*" } });
  const type = (res.headers.get("content-type") || "").split(";")[0].trim().toLowerCase();
  if (!res.ok || !type.startsWith("image/") || Number(res.headers.get("content-length")) > SITE_ICON_MAX_BYTES) {
    res.body?.cancel().catch(() => {});
    return null;
  }
  const body = Buffer.from(await res.arrayBuffer());
  return body.length && body.length <= SITE_ICON_MAX_BYTES ? { type, body } : null;
}

async function resolveIcon(page) {
  let html = "";
  let base = page;
  try {
    const res = await fetch(page, { signal: AbortSignal.timeout(5000), headers: { accept: "text/html" } });
    base = res.url || page;
    if (res.ok) html = (await res.text()).slice(0, 500000);
  } catch {
    // app down or unreachable: only /favicon.ico is tried
  }
  for (const url of iconCandidates(html, base)) {
    try {
      const icon = await download(url);
      if (icon) return icon;
    } catch {
      // next candidate
    }
  }
  return null;
}

function siteIcon(page) {
  const hit = siteIcons.get(page);
  if (hit?.pending) return hit.pending;
  if (hit && Date.now() - hit.at < (hit.body ? SITE_ICON_TTL_MS : SITE_ICON_RETRY_MS)) return Promise.resolve(hit);
  const pending = resolveIcon(page).then((icon) => {
    const entry = { at: Date.now(), ...icon };
    siteIcons.set(page, entry);
    return entry;
  });
  siteIcons.set(page, { pending });
  return pending;
}

async function siteIconFor(name) {
  const c = (await snapshot()).containers.find((x) => x.name === name);
  const page = c && c.url && publicUrl(c.url);
  const icon = page ? await siteIcon(page) : null;
  // The icon comes from the app; never let it act as a page on this origin
  const headers = { "content-security-policy": "default-src 'none'; style-src 'unsafe-inline'; sandbox" };
  return icon?.body
    ? { type: icon.type, body: icon.body, cache: "private, max-age=3600", headers }
    : { type: "image/svg+xml", body: GLOBE, cache: "private, max-age=300", headers };
}

// ---------------------------------------------------------------- widgets
// umbrelOS draws these itself (same glass look as the built-in widgets).

async function projectsWidget() {
  try {
    const { projects, containers, counts } = await snapshot();
    return {
      type: "list-emoji",
      refresh: REFRESH,
      link: "",
      count: counts.ok + "/" + containers.length,
      items: projects.length
        ? projects.map((p) => ({
            emoji: STATES[p.state].emoji,
            text: p.name + " " + p.ok + "/" + p.containers.length,
          }))
        : [{ emoji: "🫙", text: "No containers of yours yet" }],
    };
  } catch (error) {
    return {
      type: "list-emoji",
      refresh: REFRESH,
      link: "",
      count: "?",
      items: [{ emoji: "❗", text: "Docker unavailable: " + error.message }],
    };
  }
}

// Same shape as the native "Live Usage" widget: three pill cells with an icon
// (any Tabler icon name), a label and a value
async function summaryWidget() {
  let stats = null;
  try {
    stats = totals(await snapshot());
  } catch {
    // shown as dashes below
  }
  const issues = stats ? stats.issues : null;
  return {
    type: "three-stats",
    refresh: REFRESH,
    link: "",
    items: [
      { icon: "box", subtext: "Containers", text: stats ? stats.okContainers + "/" + stats.containers : "–" },
      { icon: "stack-2", subtext: "Projects", text: stats ? stats.okProjects + "/" + stats.projects : "–" },
      {
        icon: issues === 0 ? "shield-check" : "alert-triangle",
        subtext: "Issues",
        text: issues === null ? "–" : String(issues),
      },
    ],
  };
}

// Two rings that fill up with the healthy share of containers and projects
async function gaugesWidget() {
  let stats = null;
  try {
    stats = totals(await snapshot());
  } catch {
    // empty rings below
  }
  const ring = (title, ok, total) => ({
    title,
    text: stats ? ok + "/" + total : "–",
    progress: stats && total > 0 ? Number((ok / total).toFixed(2)) : 0,
  });
  return {
    type: "two-stats-with-guage", // sic: umbrelOS spells it this way
    refresh: REFRESH,
    link: "",
    items: [
      ring("Containers", stats?.okContainers, stats?.containers),
      ring("Projects", stats?.okProjects, stats?.projects),
    ],
  };
}

function totals({ projects, containers, counts }) {
  return {
    containers: containers.length,
    okContainers: counts.ok,
    projects: projects.length,
    okProjects: projects.filter((p) => p.state === "ok").length,
    issues: containers.length - counts.ok,
  };
}

// ---------------------------------------------------------------- status page

const escape = (s) =>
  String(s).replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch]);

function bytes(n) {
  if (n == null) return "–";
  const mib = n / 1048576;
  if (mib >= 1024) return (mib / 1024).toFixed(1) + " GiB";
  return (mib >= 100 ? mib.toFixed(0) : mib.toFixed(1)) + " MiB";
}

const pct = (part, whole) => (whole ? Math.min(100, Math.max(1, (part / whole) * 100)).toFixed(1) : "0");

const hostname = (url) => {
  try {
    return new URL(url).hostname;
  } catch {
    return null;
  }
};

// Only http(s) addresses become links (the label is free text)
const publicUrl = (url) => {
  try {
    const u = new URL(url);
    return u.protocol === "https:" || u.protocol === "http:" ? u.href : null;
  } catch {
    return null;
  }
};

const appLink = (c, cls) => {
  const href = c.url && publicUrl(c.url);
  return href
    ? '<a class="' + cls + '" href="' + escape(href) + '" target="_blank" rel="noopener noreferrer" title="Open ' + escape(href) + '">' +
        "<span>" + escape(hostname(href)) + "</span>" + icon("out") + "</a>"
    : "";
};

// The app's own icon (see siteIconFor), linking to its public address
const appIcon = (c) => {
  const href = c.url && publicUrl(c.url);
  return href
    ? '<a class="fav" href="' + escape(href) + '" target="_blank" rel="noopener noreferrer" title="Open ' + escape(href) + '">' +
        '<img src="site-icon?app=' + escape(encodeURIComponent(c.name)) + '" alt="" width="20" height="20"></a>'
    : "";
};

