// Container Health: umbrelOS widgets + a status page for the containers you run
// yourself (LocalInfra, your projects), skipping the ones umbrelOS manages.
//
// Read-only by design (the one thing it does besides reading is the speed test, which only makes
// outbound requests when someone presses its button): the only Docker API calls are GET /containers/json and, for
// the status page only, GET /containers/<id>/stats (one-shot memory reading) and, once
// per container, GET /containers/<id>/json + /archive to read its app version.
// The status page also shows each app's icon, fetched from its public address.
// No dependencies; runs on a stock node:alpine image.
//
// This is a ".template" because umbrelOS app updates only copy whitelisted
// files (docker-compose.yml, *.template, ...). Templates are rendered with
// envsubst, so this file must NOT contain the dollar sign at all: no template
// literals, no regex end anchors. scripts/check-health-app.sh enforces it.
import http from "node:http";
import { execFile } from "node:child_process";
import os from "node:os";
import { randomBytes } from "node:crypto";

const PORT = Number(process.env.PORT || 3000);
const DOCKER_SOCKET = process.env.DOCKER_SOCKET || "/var/run/docker.sock";
// Containers umbrelOS starts carry this compose working dir; yours carry the
// folder you deployed from (e.g. /Users/you/Code/project), so they stay visible.
const EXCLUDE_WORKDIR_PREFIXES = (process.env.EXCLUDE_WORKDIR_PREFIXES || "/opt/umbreld/")
  .split(",")
  .map((s) => s.trim())
  .filter(Boolean);
// Opt-out for one-off containers: docker run --label localinfra.health.hide=true ...
const HIDE_LABEL = "localinfra.health.hide";
// Optional public URL of an app (the app template sets it from NEXT_PUBLIC_APP_URL)
const URL_LABEL = "localinfra.url";
const REFRESH = process.env.WIDGET_REFRESH || "30s";
// Memory readings are shared by every open status page for this long
const MEMORY_TTL_MS = 10000;
// App icons (fetched from each app's public address) are kept this long
const SITE_ICON_TTL_MS = 12 * 3600 * 1000;
const SITE_ICON_RETRY_MS = 10 * 60 * 1000;
const SITE_ICON_MAX_BYTES = 256 * 1024;
// Version label an image can set (docker build --label / LABEL in the Dockerfile)
const VERSION_LABEL = "org.opencontainers.image.version";
const PACKAGE_JSON_MAX_BYTES = 256 * 1024;
// LocalInfra's own compose project: its helpers (the backup joins localinfra_postgres to dump
// it) are infrastructure, not apps, so the resource map leaves them out
const LOCALINFRA_PROJECT = "localinfra";
// The nightly backup container; its scripts write their results as JSON (backup/status.sh)
const BACKUP_CONTAINER = process.env.BACKUP_CONTAINER || "localinfra-backup";
const BACKUP_TTL_MS = 60 * 1000;
// Same window as the backup container's healthcheck
const BACKUP_STALE_MS = 26 * 3600 * 1000;
// Newest release of the pinned images (UPDATE_CHECKS), looked up on Docker Hub
const UPDATE_TTL_MS = 12 * 3600 * 1000;
const UPDATE_RETRY_MS = 3600 * 1000;

const STATES = {
  ok: { rank: 0, emoji: "✅", label: "Healthy" },
  starting: { rank: 1, emoji: "⏳", label: "Starting" },
  unhealthy: { rank: 2, emoji: "⚠️", label: "Unhealthy" },
  stopped: { rank: 3, emoji: "❌", label: "Stopped" },
};

// What LocalInfra provides. A container uses a resource when it joins its network.
const RESOURCES = [
  { key: "postgres", label: "Postgres", short: "PG", network: "localinfra_postgres", provider: "localinfra-postgres" },
  { key: "redis", label: "Redis", short: "RD", network: "localinfra_redis", provider: "localinfra-redis" },
  { key: "s3", label: "S3", short: "S3", network: "localinfra_s3", provider: "localinfra-s3" },
  { key: "llm", label: "LLM", short: "AI", network: "localinfra_llm", provider: "localinfra-llm" },
  { key: "metrics", label: "Metrics", short: "MX", network: "localinfra_metrics", provider: "localinfra-metrics" },
  // Every app on this network can be reached by the Cloudflare tunnel
  { key: "tunnel", label: "Tunnel", short: "CF", network: "localinfra_tunnel", provider: "localinfra-tunnel" },
];

// Raw body of a GET; the error carries the HTTP status (404 = no such file, for /archive)
function dockerRaw(path, maxBytes = Infinity) {
  return new Promise((resolve, reject) => {
    const req = http.request(
      { socketPath: DOCKER_SOCKET, path, method: "GET", timeout: 5000 },
      (res) => {
        const chunks = [];
        let size = 0;
        res.on("data", (chunk) => {
          size += chunk.length;
          if (size > maxBytes) return req.destroy(new Error("Docker API response too large"));
          chunks.push(chunk);
        });
        res.on("end", () => {
          if (res.statusCode !== 200) return reject(Object.assign(new Error("Docker API " + res.statusCode), { status: res.statusCode }));
          resolve(Buffer.concat(chunks));
        });
      },
    );
    req.on("timeout", () => req.destroy(new Error("Docker API timeout")));
    req.on("error", reject);
    req.end();
  });
}

const dockerGet = async (path) => JSON.parse((await dockerRaw(path)).toString("utf8"));

function classify(container) {
  const status = container.Status || "";
  switch (container.State) {
    case "running":
      if (/\(unhealthy\)/.test(status)) return "unhealthy";
      if (/\(health: starting\)/.test(status)) return "starting";
      return "ok";
    case "restarting": // a restart loop is a problem, not progress
      return "unhealthy";
    default: // created, exited, paused, dead, removing
      return "stopped";
  }
}

function isMine(container) {
  const labels = container.Labels || {};
  if (labels[HIDE_LABEL] === "true") return false;
  const workdir = labels["com.docker.compose.project.working_dir"] || "";
  return !EXCLUDE_WORKDIR_PREFIXES.some((prefix) => workdir.startsWith(prefix));
}

const worst = (states) =>
  states.reduce((a, b) => (STATES[b].rank > STATES[a].rank ? b : a), "ok");

function describe(c) {
  const name = (c.Names?.[0] || c.Id.slice(0, 12)).replace(/^\//, "");
  const networks = Object.keys(c.NetworkSettings?.Networks || {});
  return {
    id: c.Id,
    name,
    project: c.Labels?.["com.docker.compose.project"] || null,
    state: classify(c),
    running: c.State === "running" || c.State === "restarting",
    status: c.Status || c.State,
    image: c.Image,
    imageVersion: c.Labels?.[VERSION_LABEL] || null,
    url: c.Labels?.[URL_LABEL] || null,
    port: (c.Ports || []).find((p) => p.Type === "tcp")?.PrivatePort || 3000,
    // A provider doesn't "use" its own network
    uses: RESOURCES.filter((r) => networks.includes(r.network) && r.provider !== name).map((r) => r.key),
  };
}

async function snapshot() {
  const list = await dockerGet("/containers/json?all=true");
  const containers = list.filter(isMine).map(describe);

  // One group per compose project; containers outside compose stand alone
  const groups = new Map();
  for (const c of containers) {
    const key = c.project || c.name;
    if (!groups.has(key)) groups.set(key, { name: key, containers: [] });
    groups.get(key).containers.push(c);
  }
  const projects = [...groups.values()]
    .map((g) => ({
      ...g,
      state: worst(g.containers.map((c) => c.state)),
      ok: g.containers.filter((c) => c.state === "ok").length,
      containers: g.containers.sort((a, b) => STATES[b.state].rank - STATES[a.state].rank || a.name.localeCompare(b.name)),
    }))
    // Problems first, so they stay visible in a small widget
    .sort((a, b) => STATES[b.state].rank - STATES[a.state].rank || a.name.localeCompare(b.name));

  const counts = { ok: 0, starting: 0, unhealthy: 0, stopped: 0 };
  for (const c of containers) counts[c.state]++;

  return { projects, containers, counts };
}

// ---------------------------------------------------------------- memory
// One one-shot stats call per running container, only while a status page is
// open, cached for MEMORY_TTL_MS and at most 4 calls at a time.

let memoryCache = { at: 0, byId: new Map(), pending: null };

async function readMemory(id) {
  const s = await dockerGet("/containers/" + id + "/stats?stream=false&one-shot=true");
  const m = s.memory_stats || {};
  const st = m.stats || {};
  // Same number as `docker stats`: usage minus the page cache that can be dropped
  const cache = st.inactive_file ?? st.total_inactive_file ?? 0;
  const used = Math.max(0, (m.usage || 0) - cache);
  // Without a limit Docker reports the host's memory
  const limit = m.limit && m.limit < os.totalmem() * 0.98 ? m.limit : null;
  return m.usage == null ? null : { used, limit };
}

async function memoryFor(targets) {
  if (Date.now() - memoryCache.at < MEMORY_TTL_MS) return memoryCache.byId;
  if (memoryCache.pending) return memoryCache.pending;
  memoryCache.pending = (async () => {
    const byId = new Map();
    const queue = targets.filter((c) => c && c.running);
    const worker = async () => {
      while (queue.length) {
        const c = queue.shift();
        try {
          const reading = await readMemory(c.id);
          if (reading) byId.set(c.id, reading);
        } catch {
          // left blank on the page
        }
      }
    };
    await Promise.all([worker(), worker(), worker(), worker()]);
    memoryCache = { at: Date.now(), byId, pending: null };
    return byId;
  })().finally(() => (memoryCache.pending = null));
  return memoryCache.pending;
}

// ---------------------------------------------------------------- versions
// What each container runs, for the project list. In order: the image's version label,
// the image tag (postgres:17-alpine, localinfra-s3:v2.4.1), and for ":latest" images (the
// apps deployed with deploy.sh) the "version" of package.json in the container's working
// dir, read once per container through Docker's read-only archive endpoint.

// container id -> { version, source } (version null = none found)
const versionCache = new Map();
let versionsPending = null;

// "repo/name:tag@sha256:..." -> "tag"; none for ":latest", bare names and image ids
function imageTag(image) {
  const ref = (image || "").split("@")[0];
  if (ref.startsWith("sha256:")) return null;
  const colon = ref.lastIndexOf(":");
  if (colon < 0 || colon < ref.lastIndexOf("/")) return null;
  const tag = ref.slice(colon + 1);
  return tag && tag !== "latest" ? tag : null;
}

// The first regular file in a tar stream (GET /archive answers with a tar)
function firstTarFile(buf) {
  for (let off = 0; off + 512 <= buf.length; ) {
    const header = buf.subarray(off, off + 512);
    if (header.every((b) => b === 0)) return null;
    const size = parseInt(header.subarray(124, 136).toString("latin1").replace(/[^0-7]/g, "") || "0", 8);
    const type = String.fromCharCode(header[156]);
    if (type === "0" || type === "\0") return buf.subarray(off + 512, off + 512 + size);
    off += 512 + Math.ceil(size / 512) * 512;
  }
  return null;
}

// One file of a container (running or not) through the read-only archive endpoint, like
// docker cp; null when it doesn't exist
async function containerFile(id, file, maxBytes) {
  let tar;
  try {
    tar = await dockerRaw("/containers/" + id + "/archive?path=" + encodeURIComponent(file), maxBytes + 1024);
  } catch (error) {
    if (error.status === 404) return null;
    throw error;
  }
  const body = firstTarFile(tar);
  return body ? body.toString("utf8") : null;
}

async function packageVersion(id) {
  const info = await dockerGet("/containers/" + id + "/json");
  const dir = info.Config?.WorkingDir;
  if (!dir) return null;
  const body = await containerFile(id, (dir.endsWith("/") ? dir : dir + "/") + "package.json", PACKAGE_JSON_MAX_BYTES);
  if (!body) return null;
  const version = JSON.parse(body).version;
  return typeof version === "string" && version ? version : null;
}

async function resolveVersion(c) {
  if (c.imageVersion) return { version: c.imageVersion, source: "label " + VERSION_LABEL };
  const tag = imageTag(c.image);
  if (tag) return { version: tag, source: "image tag " + c.image.split("@")[0] };
  const version = await packageVersion(c.id);
  return { version, source: "package.json" };
}

async function versionsFor(containers) {
  const ids = new Set(containers.map((c) => c.id));
  for (const id of versionCache.keys()) if (!ids.has(id)) versionCache.delete(id);
  const queue = containers.filter((c) => !versionCache.has(c.id));
  if (queue.length && !versionsPending) {
    const worker = async () => {
      while (queue.length) {
        const c = queue.shift();
        try {
          versionCache.set(c.id, await resolveVersion(c));
        } catch {
          // Docker busy or unreadable package.json: tried again on the next refresh
        }
      }
    };
    versionsPending = Promise.all([worker(), worker(), worker(), worker()]).finally(() => (versionsPending = null));
  }
  if (versionsPending) await versionsPending;
  return versionCache;
}

// ---------------------------------------------------------------- backups
// What the nightly backup holds and how its last run went, from the JSON that backup/status.sh
// writes inside localinfra-backup (read with containerFile, cached BACKUP_TTL_MS):
//   /run/backup-status/<job>.json      the last run, good or not (gone after a restart)
//   /backups/<job>/last_success.json   the last good run, with the files of its set
//   /backups/<job>/last_success        the healthcheck's timestamp (older backup images only write this)
// Never the container's environment: it holds the Postgres password.

const BACKUP_JOBS = [
  { key: "postgres", label: "Postgres", c: "postgres", what: "Roles and passwords (globals.sql) and one pg_dump per database, restored with pg_restore." },
  { key: "homeassistant", label: "Home Assistant", c: "homeassistant", what: "A copy of Home Assistant's own newest backup (encrypted .tar, made daily at 03:30)." },
];
const BACKUP_FILE_MAX_BYTES = 64 * 1024;

let backupCache = { at: 0, value: null, pending: null };

const parseJson = (text) => {
  try {
    const value = text ? JSON.parse(text) : null;
    return value && typeof value === "object" && typeof value.finished === "number" ? value : null;
  } catch {
    return null;
  }
};

// "2026-10-26T04:00:12-0300" (date +%Y-%m-%dT%H:%M:%S%z) -> ms
function stampMs(text) {
  const m = (text || "").trim().match(/^([0-9-]+T[0-9:]+)([+-][0-9]{2}):?([0-9]{2})/);
  const ms = m ? Date.parse(m[1] + m[2] + ":" + m[3]) : NaN;
  return Number.isFinite(ms) ? ms : null;
}

async function backupJob(id, job) {
  const read = (file) => containerFile(id, file, BACKUP_FILE_MAX_BYTES);
  const [run, good, stamp] = await Promise.all([
    read("/run/backup-status/" + job.key + ".json"),
    read("/backups/" + job.key + "/last_success.json"),
    read("/backups/" + job.key + "/last_success"),
  ]);
  const lastGood = parseJson(good);
  const lastRun = [parseJson(run), lastGood].filter(Boolean).sort((a, b) => b.finished - a.finished)[0] || null;
  const successAt = Math.max(lastGood ? lastGood.finished * 1000 : 0, stampMs(stamp) || 0) || null;
  let state = "unknown";
  if (lastRun && !lastRun.ok) state = "unhealthy";
  else if (successAt) state = Date.now() - successAt < BACKUP_STALE_MS ? "ok" : "unhealthy";
  return { ...job, lastRun, lastGood, successAt, state };
}

async function backups(snap) {
  const c = snap.containers.find((x) => x.name === BACKUP_CONTAINER);
  if (!c) return { container: null, jobs: [] };
  if (backupCache.value && backupCache.value.container.id === c.id && Date.now() - backupCache.at < BACKUP_TTL_MS) return backupCache.value;
  if (!backupCache.pending) {
    backupCache.pending = Promise.all(BACKUP_JOBS.map((job) => backupJob(c.id, job).catch(() => ({ ...job, state: "unknown", error: true }))))
      .then((jobs) => {
        backupCache = { at: Date.now(), value: { container: c, jobs }, pending: null };
        return backupCache.value;
      })
      .finally(() => (backupCache.pending = null));
  }
  return backupCache.pending;
}

// ---------------------------------------------------------------- metrics
// Light, anonymous usage metrics of the apps (LocalInfra/metrics): localinfra-metrics keeps them
// in Postgres and writes a summary every minute to /run/metrics/summary.json, read here with
// containerFile like the backup status (cached METRICS_TTL_MS). This app joins no network and
// holds no key for it. Routes are patterns and error messages are scrubbed by the service.
const METRICS_CONTAINER = process.env.METRICS_CONTAINER || "localinfra-metrics";
const METRICS_FILE = "/run/metrics/summary.json";
const METRICS_TTL_MS = 60 * 1000;
const METRICS_MAX_BYTES = 512 * 1024;
const RANGES = [["24h", "24 h"], ["7d", "7 days"], ["30d", "30 days"]];
// Thresholds for the 75th percentile (good up to, poor above): Google's for the Web Vitals;
// NAV, the time from a click to the new route painted, is ours
const VITALS = [
  { key: "LCP", what: "Largest Contentful Paint", good: 2500, poor: 4000 },
  { key: "INP", what: "Interaction to Next Paint", good: 200, poor: 500 },
  { key: "CLS", what: "Cumulative Layout Shift", good: 0.1, poor: 0.25 },
  { key: "FCP", what: "First Contentful Paint", good: 1800, poor: 3000 },
  { key: "TTFB", what: "Time to First Byte", good: 800, poor: 1800 },
  { key: "NAV", what: "In-app navigation: click to new route painted", good: 1000, poor: 2500 },
];

let metricsCache = { at: 0, id: null, value: null, pending: null };

async function metricsSummary(snap) {
  const c = snap.containers.find((x) => x.name === METRICS_CONTAINER);
  if (!c) return { container: null, summary: null };
  if (metricsCache.id === c.id && Date.now() - metricsCache.at < METRICS_TTL_MS) return metricsCache.value;
  if (!metricsCache.pending) {
    metricsCache.pending = containerFile(c.id, METRICS_FILE, METRICS_MAX_BYTES)
      .then((text) => {
        const summary = text ? JSON.parse(text) : null;
        return summary && typeof summary.apps === "object" && summary.apps ? summary : null;
      })
      .catch(() => null)
      .then((summary) => {
        metricsCache = { at: Date.now(), id: c.id, value: { container: c, summary }, pending: null };
        return metricsCache.value;
      })
      .finally(() => (metricsCache.pending = null));
  }
  return metricsCache.pending;
}

// ---------------------------------------------------------------- speed test
// The Pi's connection to the internet, measured only when someone presses the button on the
// status page (POST /speedtest): ping, download and upload against Cloudflare's public speed-test
// endpoints. One run at a time, a pause between runs, a capped amount of data, nothing stored
// (the last result lives in memory until the app restarts).
const SPEED_HOST = "https://speed.cloudflare.com";
const SPEED_SECONDS = Math.min(20, Math.max(3, Number(process.env.SPEEDTEST_SECONDS) || 8));
// Most data one run moves in each direction
const SPEED_MAX_BYTES = Math.min(1000, Math.max(20, Number(process.env.SPEEDTEST_MAX_MB) || 300)) * 1000000;
const SPEED_STREAMS = 4;
const SPEED_PINGS = 10;
// Fixed address for the ICMP ping (never taken from a request or the environment)
const SPEED_ICMP_ADDRESS = "1.1.1.1";
const SPEED_ICMP_PINGS = 5;
const SPEED_COOLDOWN_MS = 15 * 1000;
const SPEED_PHASES = { ping: "ping", download: "download", upload: "upload" };

// running, the phase in progress, the numbers measured so far (current) and how the last run ended
const speed = { running: false, phase: null, current: {}, last: null, finishedAt: 0 };

const median = (list) => [...list].sort((a, b) => a - b)[list.length >> 1];

const pingStats = (times, via) => ({
  ping: median(times),
  jitter: times.slice(1).reduce((sum, t, i) => sum + Math.abs(t - times[i]), 0) / (times.length - 1),
  via,
});

// Real ICMP echo with the image's own busybox ping. It needs no capability here: the kernel lets
// the container's group open an ICMP datagram socket (net.ipv4.ping_group_range), so the app keeps
// cap_drop ALL and no root. execFile, no shell, fixed arguments.
function icmpPing() {
  return new Promise((resolve, reject) => {
    execFile(
      "ping",
      ["-c", String(SPEED_ICMP_PINGS), "-W", "2", SPEED_ICMP_ADDRESS],
      { timeout: 15000, maxBuffer: 64 * 1024 },
      (error, stdout) => {
        const times = [...String(stdout || "").matchAll(/time=([0-9.]+) ms/g)].map((m) => Number(m[1]));
        if (times.length < 2) reject(new Error("ICMP ping got no replies" + (error && error.code ? " (" + error.code + ")" : "")));
        else resolve(pingStats(times, "icmp"));
      },
    );
  });
}

// Fallback: round trip of an empty HTTPS response, once the connection is open (the first
// request, which resolves DNS and does the TLS handshake, is thrown away)
async function httpsPing() {
  const times = [];
  for (let i = 0; i <= SPEED_PINGS; i++) {
    const started = performance.now();
    const res = await fetch(SPEED_HOST + "/__down?bytes=0", { signal: AbortSignal.timeout(5000) });
    if (!res.ok) throw new Error("Cloudflare answered " + res.status);
    await res.arrayBuffer();
    if (i > 0) times.push(performance.now() - started);
  }
  return pingStats(times, "https");
}

const pingTest = () => icmpPing().catch(() => httpsPing());

// Megabits per second: several parallel downloads for SPEED_SECONDS (or until SPEED_MAX_BYTES)
async function downloadTest() {
  const stop = new AbortController();
  const each = Math.floor(SPEED_MAX_BYTES / SPEED_STREAMS);
  let received = 0;
  const started = performance.now();
  const timer = setTimeout(() => stop.abort(), SPEED_SECONDS * 1000);
  try {
    await Promise.all(
      Array.from({ length: SPEED_STREAMS }, async () => {
        try {
          const res = await fetch(SPEED_HOST + "/__down?bytes=" + each, { signal: stop.signal });
          if (!res.ok) throw new Error("Cloudflare answered " + res.status);
          for await (const chunk of res.body) received += chunk.length;
        } catch (error) {
          if (!stop.signal.aborted) throw error;
        }
      }),
    );
  } finally {
    clearTimeout(timer);
    stop.abort();
  }
  if (!received) throw new Error("no data received");
  return (received * 8) / ((performance.now() - started) / 1000) / 1e6;
}

// Megabits per second: parallel POSTs that start small and grow while they finish in under a
// second, counted only when they complete (a slow link doesn't wait for a huge request)
async function uploadTest() {
  const payload = randomBytes(8 * 1024 * 1024);
  const stop = new AbortController();
  let sent = 0;
  const started = performance.now();
  let last = started;
  // Slow links finish the request in flight a few seconds after the deadline
  const timer = setTimeout(() => stop.abort(), (SPEED_SECONDS + 5) * 1000);
  try {
    await Promise.all(
      Array.from({ length: SPEED_STREAMS }, async () => {
        let size = 256 * 1024;
        try {
          while (performance.now() - started < SPEED_SECONDS * 1000 && sent < SPEED_MAX_BYTES) {
            const t = performance.now();
            const res = await fetch(SPEED_HOST + "/__up", {
              method: "POST",
              headers: { "content-type": "application/octet-stream" },
              body: payload.subarray(0, size),
              signal: stop.signal,
            });
            if (!res.ok) throw new Error("Cloudflare answered " + res.status);
            await res.arrayBuffer();
            sent += size;
            last = performance.now();
            if (last - t < 1000 && size < payload.length) size *= 2;
          }
        } catch (error) {
          if (!stop.signal.aborted) throw error;
        }
      }),
    );
  } finally {
    clearTimeout(timer);
    stop.abort();
  }
  if (!sent) throw new Error("nothing could be uploaded");
  return (sent * 8) / ((last - started) / 1000) / 1e6;
}

async function runSpeedTest() {
  speed.phase = SPEED_PHASES.ping;
  Object.assign(speed.current, await pingTest());
  speed.phase = SPEED_PHASES.download;
  speed.current.download = await downloadTest();
  speed.phase = SPEED_PHASES.upload;
  speed.current.upload = await uploadTest();
}

// { status, ... } for POST /speedtest: starts a run unless one is going or the last one just ended
function startSpeedTest() {
  if (speed.running) return { status: 409, error: "A test is already running." };
  const wait = speed.finishedAt + SPEED_COOLDOWN_MS - Date.now();
  if (wait > 0) return { status: 429, error: "Wait " + Math.ceil(wait / 1000) + " s before running it again." };
  speed.running = true;
  speed.current = {};
  runSpeedTest()
    .then(
      () => (speed.last = { at: Date.now(), ok: true, ...speed.current }),
      (error) => (speed.last = { at: Date.now(), ok: false, error: String((error.cause && error.cause.code) || error.message || error), ...speed.current }),
    )
    .finally(() => {
      speed.running = false;
      speed.phase = null;
      speed.finishedAt = Date.now();
    });
  return { status: 202 };
}

// ---------------------------------------------------------------- updates
// LocalInfra pins these images to a version in its .env. While a status page is open, the
// server looks up the newest release tag on Docker Hub (at most every UPDATE_TTL_MS) and the
// page suggests the update. Nothing is pulled or changed from here.

const UPDATE_CHECKS = [
  { container: "localinfra-tunnel", name: "cloudflared", repo: "cloudflare/cloudflared", env: "CLOUDFLARED_VERSION", service: "tunnel",
    brand: "cloudflare", c: "tunnel", notes: "https://github.com/cloudflare/cloudflared/releases" },
];

// repo -> { at, ok, latest } or { pending, latest }
const updateCache = new Map();

// "2026.10.4" -> [2026, 10, 4]; null for "latest", build ids, "-arm64" suffixes...
function releaseParts(tag) {
  const m = /^[0-9]+(\.[0-9]+){1,3}/.exec(tag || "");
  return m && m[0] === tag ? tag.split(".").map(Number) : null;
}

function isNewer(a, b) {
  for (let i = 0; i < Math.max(a.length, b.length); i++) {
    const d = (a[i] || 0) - (b[i] || 0);
    if (d) return d > 0;
  }
  return false;
}

// Docker's name for this machine's architecture (the Pi: arm64)
const DOCKER_ARCH = { x64: "amd64", arm64: "arm64", arm: "arm" }[os.arch()] || os.arch();

async function latestRelease(repo) {
  const res = await fetch("https://hub.docker.com/v2/repositories/" + repo + "/tags?page_size=50&ordering=last_updated", {
    signal: AbortSignal.timeout(5000),
    headers: { accept: "application/json" },
  });
  if (!res.ok) throw new Error("Docker Hub " + res.status);
  let best = null;
  for (const t of (await res.json()).results || []) {
    const parts = releaseParts(t.name);
    // Only tags that have an image for this machine
    if (!parts || (Array.isArray(t.images) && !t.images.some((i) => i.architecture === DOCKER_ARCH))) continue;
    if (!best || isNewer(parts, best.parts)) best = { tag: t.name, parts };
  }
  return best ? best.tag : null;
}

function latestFor(repo) {
  const hit = updateCache.get(repo);
  if (hit && (hit.pending || Date.now() - hit.at < (hit.ok ? UPDATE_TTL_MS : UPDATE_RETRY_MS))) return hit;
  const latest = hit ? hit.latest : null;
  const pending = latestRelease(repo).then(
    (tag) => updateCache.set(repo, { at: Date.now(), ok: true, latest: tag }),
    () => updateCache.set(repo, { at: Date.now(), ok: false, latest }),
  );
  updateCache.set(repo, { pending, latest });
  return updateCache.get(repo);
}

// container name -> { check, running, latest }, for the pinned images with a newer release.
// Waits a moment for a lookup in flight, else the next refresh shows it.
async function updatesFor(snap) {
  const found = new Map();
  for (const check of UPDATE_CHECKS) {
    const c = snap.containers.find((x) => x.name === check.container);
    const running = c && imageTag(c.image);
    if (!running || !releaseParts(running)) continue;
    let hit = latestFor(check.repo);
    if (hit.pending) {
      await Promise.race([hit.pending, new Promise((resolve) => setTimeout(resolve, 1500))]);
      hit = updateCache.get(check.repo);
    }
    const latest = hit.latest && releaseParts(hit.latest);
    if (latest && isNewer(latest, releaseParts(running))) found.set(c.name, { check, running, latest: hit.latest });
  }
  return found;
}

// ---------------------------------------------------------------- app icons
// The resource map shows each app's own icon. Apps declare it in different places
// (<link rel="icon"> with an .svg, a .png, a 1024px .ico...), so the server reads the
// app's page once, picks the best one, and keeps it in memory. Only addresses from the
// localinfra.url label are ever fetched.

const GLOBE =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#22d3ee" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">' +
  '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.6 3.5 5.4 3.5 8.5s-1.1 5.9-3.5 8.5c-2.4-2.6-3.5-5.4-3.5-8.5S9.6 6.1 12 3.5z"/></svg>';

// page address -> { at, type, body } (no body = no usable icon) or { pending }
const siteIcons = new Map();

const attr = (tag, name) => {
  const m = tag.match(new RegExp("\\s" + name + "\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))", "i"));
  return m ? (m[1] ?? m[2] ?? m[3]).replace(/&amp;/g, "&") : null;
};

// Best first: SVG, then a 32-256px bitmap, any other bitmap, apple-touch-icon, .ico
function iconCandidates(html, page) {
  const found = [];
  for (const tag of html.match(/<link\b[^>]*>/gi) || []) {
    const rel = (attr(tag, "rel") || "").toLowerCase().split(/\s+/);
    const href = attr(tag, "href");
    if (!href || !(rel.includes("icon") || rel.includes("apple-touch-icon"))) continue;
    let url;
    try {
      url = new URL(href, page);
    } catch {
      continue;
    }
    if (url.protocol !== "https:" && url.protocol !== "http:") continue;
    const type = (attr(tag, "type") || "").toLowerCase();
    const path = url.pathname.toLowerCase();
    const size = Number(((attr(tag, "sizes") || "").match(/\d+/) || [])[0]) || 0;
    let rank;
    if (type.includes("svg") || path.endsWith(".svg")) rank = 0;
    else if (type.includes("icon") || path.endsWith(".ico")) rank = 4;
    else if (rel.includes("apple-touch-icon")) rank = 3;
    else rank = size >= 32 && size <= 256 ? 1 : 2;
    found.push({ url: url.href, rank, size });
  }
  found.sort((a, b) => a.rank - b.rank || Math.abs(a.size - 64) - Math.abs(b.size - 64));
  const urls = found.map((f) => f.url);
  urls.push(new URL("/favicon.ico", page).href);
  return [...new Set(urls)];
}

async function download(url) {
  const res = await fetch(url, { signal: AbortSignal.timeout(5000), headers: { accept: "image/*" } });
  const type = (res.headers.get("content-type") || "").split(";")[0].trim().toLowerCase();
  if (!res.ok || !type.startsWith("image/") || Number(res.headers.get("content-length")) > SITE_ICON_MAX_BYTES) {
    res.body?.cancel().catch(() => {});
    return null;
  }
  const body = Buffer.from(await res.arrayBuffer());
  return body.length && body.length <= SITE_ICON_MAX_BYTES ? { type, body } : null;
}

async function resolveIcon(page) {
  let html = "";
  let base = page;
  try {
    const res = await fetch(page, { signal: AbortSignal.timeout(5000), headers: { accept: "text/html" } });
    base = res.url || page;
    if (res.ok) html = (await res.text()).slice(0, 500000);
  } catch {
    // app down or unreachable: only /favicon.ico is tried
  }
  for (const url of iconCandidates(html, base)) {
    try {
      const icon = await download(url);
      if (icon) return icon;
    } catch {
      // next candidate
    }
  }
  return null;
}

function siteIcon(page) {
  const hit = siteIcons.get(page);
  if (hit?.pending) return hit.pending;
  if (hit && Date.now() - hit.at < (hit.body ? SITE_ICON_TTL_MS : SITE_ICON_RETRY_MS)) return Promise.resolve(hit);
  const pending = resolveIcon(page).then((icon) => {
    const entry = { at: Date.now(), ...icon };
    siteIcons.set(page, entry);
    return entry;
  });
  siteIcons.set(page, { pending });
  return pending;
}

async function siteIconFor(name) {
  const c = (await snapshot()).containers.find((x) => x.name === name);
  const page = c && c.url && publicUrl(c.url);
  const icon = page ? await siteIcon(page) : null;
  // The icon comes from the app; never let it act as a page on this origin
  const headers = { "content-security-policy": "default-src 'none'; style-src 'unsafe-inline'; sandbox" };
  return icon?.body
    ? { type: icon.type, body: icon.body, cache: "private, max-age=3600", headers }
    : { type: "image/svg+xml", body: GLOBE, cache: "private, max-age=300", headers };
}

// ---------------------------------------------------------------- widgets
// umbrelOS draws these itself (same glass look as the built-in widgets).

async function projectsWidget() {
  try {
    const { projects, containers, counts } = await snapshot();
    return {
      type: "list-emoji",
      refresh: REFRESH,
      link: "",
      count: counts.ok + "/" + containers.length,
      items: projects.length
        ? projects.map((p) => ({
            emoji: STATES[p.state].emoji,
            text: p.name + " " + p.ok + "/" + p.containers.length,
          }))
        : [{ emoji: "🫙", text: "No containers of yours yet" }],
    };
  } catch (error) {
    return {
      type: "list-emoji",
      refresh: REFRESH,
      link: "",
      count: "?",
      items: [{ emoji: "❗", text: "Docker unavailable: " + error.message }],
    };
  }
}

// Same shape as the native "Live Usage" widget: three pill cells with an icon
// (any Tabler icon name), a label and a value
async function summaryWidget() {
  let stats = null;
  try {
    stats = totals(await snapshot());
  } catch {
    // shown as dashes below
  }
  const issues = stats ? stats.issues : null;
  return {
    type: "three-stats",
    refresh: REFRESH,
    link: "",
    items: [
      { icon: "box", subtext: "Containers", text: stats ? stats.okContainers + "/" + stats.containers : "–" },
      { icon: "stack-2", subtext: "Projects", text: stats ? stats.okProjects + "/" + stats.projects : "–" },
      {
        icon: issues === 0 ? "shield-check" : "alert-triangle",
        subtext: "Issues",
        text: issues === null ? "–" : String(issues),
      },
    ],
  };
}

// Two rings that fill up with the healthy share of containers and projects
async function gaugesWidget() {
  let stats = null;
  try {
    stats = totals(await snapshot());
  } catch {
    // empty rings below
  }
  const ring = (title, ok, total) => ({
    title,
    text: stats ? ok + "/" + total : "–",
    progress: stats && total > 0 ? Number((ok / total).toFixed(2)) : 0,
  });
  return {
    type: "two-stats-with-guage", // sic: umbrelOS spells it this way
    refresh: REFRESH,
    link: "",
    items: [
      ring("Containers", stats?.okContainers, stats?.containers),
      ring("Projects", stats?.okProjects, stats?.projects),
    ],
  };
}

function totals({ projects, containers, counts }) {
  return {
    containers: containers.length,
    okContainers: counts.ok,
    projects: projects.length,
    okProjects: projects.filter((p) => p.state === "ok").length,
    issues: containers.length - counts.ok,
  };
}

// ---------------------------------------------------------------- status page

const escape = (s) =>
  String(s).replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch]);

function bytes(n) {
  if (n == null) return "–";
  if (n < 1024) return n + " B";
  if (n < 1048576) return (n / 1024).toFixed(n < 102400 ? 1 : 0) + " KiB";
  const mib = n / 1048576;
  if (mib >= 1024) return (mib / 1024).toFixed(1) + " GiB";
  return (mib >= 100 ? mib.toFixed(0) : mib.toFixed(1)) + " MiB";
}

const pct = (part, whole) => (whole ? Math.min(100, Math.max(1, (part / whole) * 100)).toFixed(1) : "0");

const hostname = (url) => {
  try {
    return new URL(url).hostname;
  } catch {
    return null;
  }
};

// Only http(s) addresses become links (the label is free text)
const publicUrl = (url) => {
  try {
    const u = new URL(url);
    return u.protocol === "https:" || u.protocol === "http:" ? u.href : null;
  } catch {
    return null;
  }
};

const appLink = (c, cls) => {
  const href = c.url && publicUrl(c.url);
  return href
    ? '<a class="' + cls + '" href="' + escape(href) + '" target="_blank" rel="noopener noreferrer" title="Open ' + escape(href) + '">' +
        "<span>" + escape(hostname(href)) + "</span>" + icon("out") + "</a>"
    : "";
};

// The app's own icon (see siteIconFor), linking to its public address
const appIcon = (c) => {
  const href = c.url && publicUrl(c.url);
  return href
    ? '<a class="fav" href="' + escape(href) + '" target="_blank" rel="noopener noreferrer" title="Open ' + escape(href) + '">' +
        '<img src="site-icon?app=' + escape(encodeURIComponent(c.name)) + '" alt="" width="20" height="20"></a>'
    : "";
};

